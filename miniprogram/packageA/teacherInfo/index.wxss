.teacher{
  padding: 20rpx 10rpx;
}
.teacher-box{
  width: 100%;
  display: flex;
  flex-direction: column;
  /* justify-content: center; */
  align-items: center;
}
.teacher-box-img{
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  box-shadow: 0rpx 0rpx 20rpx 10rpx #e6eceb;
}
.teacher-box-txt{
  font-size: 24rpx;
  color: #333333;
  padding: 20rpx 20rpx 0;
}

.teacher-schedule-title{
  margin-top: 10rpx;
  padding-left: 10rpx;
  border-left: solid 5px #4caf50;
  color: #333333;
}

.teacher-schedule-time{
  font-size: 26rpx;
  padding: 20rpx;
}

.teacher-schedule-title-btn{
  color: #e05a4f;
}

.teacher-schedule-content-grid-item{
  background: #ffffff;
  padding: 20rpx 10rpx;
}

.teacher-schedule-content-grid-item .item-item {
  font-size: 28rpx;
  color: #333333;
  padding: 10rpx 20rpx;
  display: flex;
  justify-content: space-between;
}

.teacher-schedule-btn{
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }
