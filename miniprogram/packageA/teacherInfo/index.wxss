.teacher{
  padding: 20rpx 10rpx;
}
.teacher-box{
  width: 100%;
  display: flex;
  flex-direction: column;
  /* justify-content: center; */
  align-items: center;
}
.teacher-box-img{
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  box-shadow: 0rpx 0rpx 20rpx 10rpx #e6eceb;
}
.teacher-box-txt{
  font-size: 24rpx;
  color: #333333;
  padding: 20rpx 20rpx 0;
}

.teacher-schedule-title{
  margin-top: 10rpx;
  padding-left: 10rpx;
  border-left: solid 5px #4caf50;
  color: #333333;
}

.teacher-schedule-time{
  font-size: 26rpx;
  padding: 20rpx;
}

.teacher-schedule-title-btn{
  color: #e05a4f;
}

.teacher-schedule-content-grid-item{
  background: #ffffff;
  padding: 20rpx 10rpx;
}

.teacher-schedule-content-grid-item .item-item {
  font-size: 28rpx;
  color: #333333;
  padding: 10rpx 20rpx;
  display: flex;
  justify-content: space-between;
}

.teacher-schedule-btn{
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }


/* ===== v8 · 页面版式统一（ClassHourCatch 尺寸语言） =====
   按钮 80rpx/8rpx · 卡片 12rpx/20rpx · 列表 gap 20rpx · 标题左竖条 */

.teacher-box,
.teacher-box-img,
.teacher-schedule-content,
.teacher-schedule-content-grid,
.teacher-schedule-content-grid-item,
.item-item {
  margin-bottom: 20rpx;
}

.teacher-schedule-content,
.teacher-schedule-content-grid,
.teacher-schedule-content-grid-item,
.item-item {
  border-radius: 12rpx;
}

.teacher-schedule-title-btn,
.teacher-schedule-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
}

.teacher-schedule-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3f6f70;
  padding-left: 20rpx;
  border-left: 8rpx solid #3f6f70;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

input, textarea {
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  min-height: 80rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

button {
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

image { border-radius: 12rpx; }

.avatar, .container-info-img, .status-dot, .dot-green, .dot-red, .hero-deco, .hero-deco-a, .hero-deco-b { border-radius: 50%; }
