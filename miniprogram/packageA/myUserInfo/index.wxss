.user-info .item{
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 20rpx 30rpx;
	border-bottom: solid 1px #e6eceb;
}

.user-info .item .item-img{
	width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.user-info .item .item-header {
  background: #8aa88f;
  border-radius: 30rpx;
}

.user-info .item  input{
	/* border: solid 1px #e6eceb; */
	width: 60%;
	height: 70rpx;
	padding: 0 5rpx;
	text-align: right;
}

.user-info  .save{
	margin: 40rpx 0 0 5% ;
	width: 90%;
	height: 70rpx;
	line-height: 70rpx;
	border-radius: 140rpx;
  font-size: 36rpx;
  background: #8aa88f;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }


/* ===== v8 · 页面版式统一（ClassHourCatch 尺寸语言） =====
   按钮 80rpx/8rpx · 卡片 12rpx/20rpx · 列表 gap 20rpx · 标题左竖条 */

.item-input,
.calculate-input {
  background: #f8f8f8;
  border: 1rpx solid #e6eceb;
  border-radius: 8rpx;
  padding: 20rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
}

input, textarea {
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  min-height: 80rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

button {
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

image { border-radius: 12rpx; }

.avatar, .container-info-img, .status-dot, .dot-green, .dot-red, .hero-deco, .hero-deco-a, .hero-deco-b { border-radius: 50%; }
