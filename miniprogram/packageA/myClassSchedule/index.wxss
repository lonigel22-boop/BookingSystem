.myClassSchedule-container{
  height: 100%;
}

.myClassSchedule-containe-hint{
  padding: 10rpx;
  text-align: center;
  color: #333333;
}

.myClassSchedule-container-list-btn{
  display: flex;
  justify-content: center;
  padding: 20rpx;
}

.myClassSchedule-container-list-swipe{
  padding: 20rpx 0;
}

.myClassSchedule-container-list-swipe-btn+.appointmentCourse-list-swipe-btn{
  margin-left: 10rpx;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }
