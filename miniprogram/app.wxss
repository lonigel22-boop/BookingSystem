/**app.wxss · 全站统一主题（ClassHourCatch 风格）**/
page {
  background: #f5f5f5;
  color: #333333;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  /* vant-weapp 主题变量：把默认蓝统一成墨绿 */
  --button-primary-background-color: #3f6f70;
  --button-primary-border-color: #3f6f70;
  --button-info-background-color: #5a8d89;
  --button-info-border-color: #5a8d89;
  --button-danger-background-color: #e05a4f;
  --button-danger-border-color: #e05a4f;
  --button-default-background-color: #ffffff;
  --radio-checked-icon-color: #3f6f70;
  --checkbox-checked-icon-color: #3f6f70;
  --switch-on-background-color: #3f6f70;
  --slider-active-background-color: #3f6f70;
  --tab-active-text-color: #3f6f70;
  --tabs-bottom-bar-color: #3f6f70;
  --dropdown-menu-title-active-text-color: #3f6f70;
  --dropdown-item-option-active-color: #3f6f70;
  --dialog-confirm-button-text-color: #3f6f70;
  --calendar-confirm-button-background-color: #3f6f70;
  --calendar-confirm-button-border-color: #3f6f70;
  --tag-primary-color: #3f6f70;
  --loading-text-color: #9aabaa;
  --cell-text-color: #333333;
  --field-input-text-color: #333333;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

button { background: initial; }
button:focus { outline: 0; }
button::after { border: none; }

/* 全站通用卡片 / 标题 / 按钮：与课时统计页一致 */
.card,
.section-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
.section-title,
.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3f6f70;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #3f6f70;
}
.primary-btn,
.export-btn,
.submit-btn {
  background: #3f6f70;
  color: #ffffff;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
}
.primary-btn[disabled],
.export-btn[disabled] { background: #cccccc; color: #ffffff; }
.muted { color: #9aabaa; }


/* ============================================================
   v8 · 全站版式系统（ClassHourCatch 尺寸语言）
   只管：按钮形状 / 圆角 / 间距 / 排布 / 输入框，不动任何配色
   ============================================================ */

/* 页面统一呼吸：20rpx 网格 */
page { box-sizing: border-box; }
view, text, button, input, textarea, picker, image { box-sizing: border-box; }

/* 通用容器：统一左右留白，避免内容贴边 */
.container {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* ★ 按钮形状：80rpx 高 + 8rpx 小圆角（扁直角矩形，不是胶囊/不是原生方块） */
button,
.van-button {
  border-radius: 8rpx !important;
  padding: 0 40rpx;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
button::after, .van-button::after { border-radius: 8rpx; }
/* 主按钮（无 size 属性）统一 80rpx 高；带 size 的小按钮保持原尺寸 */
button:not([size]), .van-button--normal, .van-button--primary { min-height: 80rpx; }
button[size="mini"], .van-button--mini {
  min-height: 56rpx; padding: 0 24rpx; font-size: 24rpx;
}
button[disabled], .van-button--disabled { opacity: .55; }

/* 装饰圆点保护：任何版式规则都不能把它们压成方角 */
.status-dot, .dot-green, .dot-red,
.hero-deco, .hero-deco-a, .hero-deco-b,
.bprogbar, .progwrap, .progbar, .tl-now { border-radius: 50%; }

/* ★ 输入框 / 表单：8rpx 圆角 + 20rpx 内距，高度对齐按钮 */
input, textarea,
.van-field, .van-field__control, .van-cell {
  border-radius: 8rpx;
  box-sizing: border-box;
}
input, textarea {
  min-height: 80rpx;
  padding: 16rpx 20rpx;
  background: #f8f8f8;
  font-size: 28rpx;
}
.van-field { min-height: 88rpx; padding: 0 20rpx; }
.van-cell { min-height: 88rpx; padding: 16rpx 20rpx; }

/* ★ vant 卡片 / 分组：12rpx 圆角，列表不再是一整块方板 */
.van-cell-group,
.van-collapse,
.van-panel,
.van-card,
.van-grid {
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.van-cell-group--inset, .van-cell-group { margin: 0 0 20rpx; }

/* picker 触发器：与输入框同形状 */
picker { border-radius: 8rpx; }

/* 弹层 / 浮层：统一圆角，避免生硬直角 */
.van-popup, .van-dialog, .van-overlay {
  border-radius: 16rpx;
}
.van-dialog { border-radius: 20rpx; }
.van-dialog__header { padding: 32rpx 24rpx 16rpx; font-size: 32rpx; font-weight: bold; }

/* 标签页 / 折叠 / 下拉：圆角与内距 */
.van-tabs__wrap { border-radius: 12rpx 12rpx 0 0; overflow: hidden; }
.van-collapse-item { border-radius: 12rpx; overflow: hidden; margin-bottom: 12rpx; }
.van-dropdown-menu { border-radius: 12rpx; overflow: hidden; }
.van-tab { font-size: 28rpx; }

/* 图片：头像圆形，普通配图 12rpx 圆角 */
.avatar, .container-info-img, .teacher-box-img,
.item-img, .header-img { border-radius: 50%; }
swiper image, .swiper-item-img, image[mode="aspectFill"] { border-radius: 12rpx; }

/* swiper 卡片化 + 圆点下移 */
swiper {
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

/* 分隔线 / 空态统一节奏 */
.empty-hint, .no-data, .no-selected {
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 徽章类保留胶囊（状态标签本来就该圆） */
.course-status, .van-tag, .badge { border-radius: 20rpx; }

/* 通用标题：左竖条 */
.section-title, .page-title {
  font-size: 32rpx;
  font-weight: bold;
  padding-left: 20rpx;
  border-left: 8rpx solid #3f6f70;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

/* 通用卡片 / 列表节奏 */
.card, .section-card {
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
