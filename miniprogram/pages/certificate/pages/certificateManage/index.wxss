.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.certificate-list, .certificate-form {
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.list-header, .form-header {
  padding: 20rpx;
  border-bottom: 2rpx solid #e6eceb;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4caf50;
}

.list-content {
  padding: 20rpx;
}

.certificate-item {
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-info {
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.info-label {
  color: #666666;
  width: 160rpx;
}

.info-value {
  color: #333333;
  flex: 1;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.action-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 6rpx;
}

.edit {
  background-color: #4caf50;
  color: #ffffff;
}

.delete {
  background-color: #e05a4f;
  color: #333333;
}

.form-content {
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  color: #333333;
  font-size: 28rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e6eceb;
  border-radius: 6rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.radio-group {
  display: flex;
  gap: 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #4caf50;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 6rpx;
  margin-top: 40rpx;
}

.no-data {
  text-align: center;
  color: #9aabaa;
  padding: 40rpx 0;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }


/* ===== v8 · 页面版式统一（ClassHourCatch 尺寸语言） =====
   按钮 80rpx/8rpx · 卡片 12rpx/20rpx · 列表 gap 20rpx · 标题左竖条 */

.form-item {
  background: #ffffff;
  border: 1rpx solid #e6eceb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.list-content,
.form-content {
  margin-bottom: 20rpx;
}

.list-content,
.form-content {
  border-radius: 12rpx;
}

.certificate-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn,
.submit-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
}

.form-input {
  background: #f8f8f8;
  border: 1rpx solid #e6eceb;
  border-radius: 8rpx;
  padding: 20rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
}

input, textarea {
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  min-height: 80rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

button {
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

image { border-radius: 12rpx; }

.avatar, .container-info-img, .status-dot, .dot-green, .dot-red, .hero-deco, .hero-deco-a, .hero-deco-b { border-radius: 50%; }
