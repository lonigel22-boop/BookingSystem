.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.certificate-list, .certificate-form {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.list-header, .form-header {
  padding: 20rpx;
  border-bottom: 2rpx solid #eee;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #006400;
}

.list-content {
  padding: 20rpx;
}

.certificate-item {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-info {
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.info-label {
  color: #666;
  width: 160rpx;
}

.info-value {
  color: #333;
  flex: 1;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.action-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 6rpx;
}

.edit {
  background-color: #006400;
  color: #fff;
}

.delete {
  background-color: #ff4d4f;
  color: #fff;
}

.form-content {
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  color: #333;
  font-size: 28rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.radio-group {
  display: flex;
  gap: 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #006400;
  color: #fff;
  font-size: 32rpx;
  border-radius: 6rpx;
  margin-top: 40rpx;
}

.no-data {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}