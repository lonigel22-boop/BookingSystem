.container {
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.header {
  margin-bottom: 60rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3f6f70;
}

.login-box {
  background: #fff;
  padding: 40rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 24rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3f6f70;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  text-align: center;
  border: none;
}

.primary-btn:active {
  opacity: 0.8;
}