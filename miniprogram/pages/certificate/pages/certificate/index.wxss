.container {
  padding: 20px;
}

.header {
  text-align: center;
  margin-bottom: 30px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #3f6f70;
}

.search-box {
  display: flex;
  margin-bottom: 20px;
}

.search-input {
  flex: 1;
  height: 40px;
  padding: 0 15px;
  border: 1px solid #e6eceb;
  border-radius: 20px;
  margin-right: 10px;
  background-color: #ffffff;
}

.search-btn {
  width: 80px;
  height: 40px;
  background-color: #3f6f70;
  color: white;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result {
  margin-top: 20px;
}

.certificate-info {
  border: 1px solid #e6eceb;
  padding: 20px;
  border-radius: 8px;
}

.info-title {
  color: #3f6f70;
  font-size: 18px;
  margin-bottom: 15px;
  display: block;
}

.info-item {
  margin-bottom: 10px;
}

.label {
  font-weight: bold;
  margin-right: 10px;
}

.view-btn {
  margin-top: 10px;
  background-color: #3f6f70;
  color: white;
  border-radius: 20px;
  width: 200px;
}

.no-result {
  text-align: center;
  color: red;
  margin-top: 20px;
}

.admin-login {
  position: fixed;
  right: 20px;
  bottom: 20px;
}

.admin-btn {
  width: 50px;
  height: 50px;
  padding: 0;
  margin: 0;
  background-color: #3f6f70;
  color: white;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }


/* ===== v8 · 页面版式统一（ClassHourCatch 尺寸语言） =====
   按钮 80rpx/8rpx · 卡片 12rpx/20rpx · 列表 gap 20rpx · 标题左竖条 */

.search-box,
.info-item {
  background: #ffffff;
  border: 1rpx solid #e6eceb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.search-btn,
.view-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
}

.search-input {
  background: #f8f8f8;
  border: 1rpx solid #e6eceb;
  border-radius: 8rpx;
  padding: 20rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
}

.title,
.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3f6f70;
  padding-left: 20rpx;
  border-left: 8rpx solid #3f6f70;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

input, textarea {
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  min-height: 80rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

button {
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

image { border-radius: 12rpx; }

.avatar, .container-info-img, .status-dot, .dot-green, .dot-red, .hero-deco, .hero-deco-a, .hero-deco-b { border-radius: 50%; }
