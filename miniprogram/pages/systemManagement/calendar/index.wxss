.calendar-container {
  padding: 20rpx;
  background-color: #ffffff;
  min-height: 100vh;
}

.calendar-header {
  margin-bottom: 30rpx;
}

.calendar-body {
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2rpx;
  padding: 10rpx 0;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  position: relative;
  border-radius: 8rpx;
}

.calendar-day:active {
  background-color: rgba(138,168,143,0.1);
}

.current-month {
  color: #333333;
}

.other-month {
  color: #cccccc;
}

.weekend {
  background-color: #3f6f70;
  color: #ffffff;
}

.weekend .course-dot {
  background-color: #ffffff;
}

.day-number {
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.day-courses {
  display: flex;
  gap: 4rpx;
  justify-content: center;
}

.course-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #3f6f70;
}

.day-detail {
  padding: 30rpx;
}

.course-detail-section {
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}

.day-detail-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  text-align: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e6eceb;
}

.day-detail-content {
  max-height: 60vh;
  overflow-y: auto;
}

.course-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1px solid #e6eceb;
}

.course-time-section {
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.course-time {
  color: #3f6f70;
  font-weight: bold;
  font-size: 32rpx;
}

.course-student {
  color: #3f6f70;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.course-info {
  flex: 1;
  margin-left: 20rpx;
}

.course-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.course-location {
  font-size: 24rpx;
  color: #666666;
}

.no-course {
  text-align: center;
  color: #9aabaa;
  padding: 40rpx 0;
  font-size: 28rpx;
}
.course-title {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.course-location {
  font-size: 26rpx;
  color: #666666;
  margin: 4rpx 0;
}

.no-courses {
  text-align: center;
  color: #9aabaa;
  padding: 40rpx 0;
  font-size: 28rpx;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }


/* ===== v8 · 页面版式统一（ClassHourCatch 尺寸语言） =====
   按钮 80rpx/8rpx · 卡片 12rpx/20rpx · 列表 gap 20rpx · 标题左竖条 */

.export-btn {
  border-radius: 8rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.course-detail-section,
.course-time-section {
  margin-bottom: 20rpx;
}

input, textarea {
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  min-height: 80rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

button {
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

image { border-radius: 12rpx; }

.avatar, .container-info-img, .status-dot, .dot-green, .dot-red, .hero-deco, .hero-deco-a, .hero-deco-b { border-radius: 50%; }
