<view class="teacherManagement-container">
  <!-- 顶部：搜索 + 添加学生（卡片化，不再被列表顶掉） -->
  <view class="teacherManagement-container-handle">
    <view class="search-box">
      <van-field
        model:value="{{ userName }}"
        center
        clearable
        label=""
        placeholder="请输入昵称或者姓名"
        border="{{ false }}"
        use-button-slot
      >
        <van-button slot="button" size="small" type="primary" color="#3f6f70" bind:tap="searchUsers">
          搜索
        </van-button>
      </van-field>
    </view>
    <view class="add-btn" catchtap="addStudentInfo">＋ 添加学生</view>
  </view>

  <!-- 标题：ClassHourCatch 同款墨绿左竖条 -->
  <view class="sec-head">
    <view class="sec-title">学生列表 · {{total}} 人</view>
    <view class="sec-tips">卡片内可编辑 / 删除，上滑加载更多</view>
  </view>

  <!-- 唯一滚动容器：flex:1 + min-height:0，真机可滚（v14 同款修法） -->
  <scroll-view class="teacherManagement-container-list" scroll-y="{{true}}" lower-threshold="100" bindscrolltolower="getUsers">
    <view class="student-grid" wx:if="{{userList && userList.length}}">
      <view class="student-cell" wx:for="{{userList}}" wx:key="_id">
        <view class="student-card">
          <view class="stu-name">{{item.name ? item.name : item.nickName}}</view>
          <view class="tag-wrap" wx:if="{{item.courseTags.length}}">
            <text class="tag" wx:for="{{item.courseTags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
            <text class="tag tag-more" wx:if="{{item.courseMore}}">+{{item.courseMore}} 门</text>
          </view>
          <view class="tag-empty" wx:else>未选课程</view>
          <view class="stu-btns">
            <view class="mini" data-data="{{item}}" catchtap="editStudent">编辑</view>
            <view class="mini danger" data-data="{{item}}" catchtap="deleteStudent">删除</view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <image class="empty-img" src="../../../images/nodata.png" />
      <view class="empty-text">还没有学生</view>
    </view>

    <view class="teacherManagement-container-popup-list-hint" wx:if="{{!hasMore && userList.length}}">没有更多数据</view>
  </scroll-view>
</view>
