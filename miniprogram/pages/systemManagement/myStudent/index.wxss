.teacherManagement-container{
  background: #ffffff;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.teacherManagement-container-handle{
  padding: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 0 10rpx 10rpx #e6eceb;
}

.teacherManagement-container-list{
  padding: 30rpx 10rpx;
  height: 100%;
  overflow-y: scroll;
}

.teacherManagement-container-list-btn+.teacherManagement-container-list-btn{
  margin-left: 20rpx;
}

.teacherManagement-container-popup-list-hint{
  width: 100%;
  padding: 10rpx;
  text-align: center;
  color: #e6eceb;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }


/* ===== v8 · 页面版式统一（ClassHourCatch 尺寸语言） =====
   按钮 80rpx/8rpx · 卡片 12rpx/20rpx · 列表 gap 20rpx · 标题左竖条 */

.teacherManagement-container-list,
.teacherManagement-container-popup-list-hint {
  margin-bottom: 20rpx;
}

.teacherManagement-container-list,
.teacherManagement-container-popup-list-hint {
  border-radius: 12rpx;
}

.teacherManagement-container-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.login-container-btn-edit,
.teacherManagement-container-list-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
}

input, textarea {
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  min-height: 80rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

button {
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

image { border-radius: 12rpx; }

.avatar, .container-info-img, .status-dot, .dot-green, .dot-red, .hero-deco, .hero-deco-a, .hero-deco-b { border-radius: 50%; }


/* ===== v15 · 「我的学生」页重做（ClassHourCatch 风格） =====
   后写覆盖：把 v8 追加层里会撑坏双列/滚动的属性归位。 */

page { background: #f5f5f5; }

.teacherManagement-container {
  height: 100vh;
  background: #f5f5f5;
  overflow: hidden;
}

/* 顶部搜索卡片 */
.teacherManagement-container-handle {
  flex: 0 0 auto;
  margin: 20rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: none;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.search-box {
  flex: 1;
  min-width: 0;
  background: #f8f8f8;
  border-radius: 8rpx;
  overflow: hidden;
}
.add-btn {
  flex: 0 0 auto;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #3f6f70;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 8rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 标题区：墨绿左竖条 */
.sec-head { flex: 0 0 auto; padding: 0 30rpx 16rpx; }
.sec-title {
  color: #3f6f70;
  font-size: 30rpx;
  font-weight: bold;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  line-height: 1.4;
}
.sec-tips { font-size: 24rpx; color: #9aabaa; padding: 10rpx 0 0 28rpx; }

/* ★ 唯一滚动容器：flex:1 + min-height:0，真机可滚。
   覆盖原 height:100% / overflow-y:scroll / display:flex / gap 双滚动嵌套。 */
.teacherManagement-container-list {
  flex: 1;
  min-height: 0;
  height: auto;
  overflow: hidden;
  display: block;
  gap: 0;
  padding: 0 20rpx 20rpx;
  margin-bottom: 0;
  border-radius: 0;
  box-sizing: border-box;
}

/* 两列：整数百分比 + padding，不用 gap / calc（v11 踩过模拟器坑） */
.student-grid { display: flex; flex-wrap: wrap; }
.student-cell { width: 50%; padding: 10rpx; box-sizing: border-box; }
.student-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 176rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.stu-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tag-wrap { flex: 1; display: flex; flex-wrap: wrap; gap: 8rpx; margin: 12rpx 0; }
.tag {
  display: block;
  max-width: 100%;
  font-size: 22rpx;
  line-height: 1.5;
  color: #3f6f70;
  background: #eef4f4;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}
.tag-more { background: #f5f5f5; color: #9aabaa; }
.tag-empty { flex: 1; font-size: 22rpx; color: #b9c5c4; padding-top: 12rpx; }

/* 横排小按钮：删除改浅红描边，不再是大红方块 */
.stu-btns { display: flex; gap: 12rpx; margin-top: 16rpx; }
.mini {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #3f6f70;
  color: #3f6f70;
  font-size: 24rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.mini.danger { border-color: #e8b3ad; color: #d9534f; background: #fff7f6; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0; }
.empty-img { width: 240rpx; height: 200rpx; }
.empty-text { color: #333333; font-size: 30rpx; padding: 20rpx; }

.teacherManagement-container-popup-list-hint {
  color: #9aabaa;
  font-size: 24rpx;
  margin-bottom: 0;
  border-radius: 0;
}
