.sm-container-shop{
  width: 100%;
  padding: 0rpx;
  box-sizing: border-box;
  margin: 0 auto;
  background: #fff;
}

.sm-container-shop-info{
  padding: 20rpx;
  font-size: 28rpx;
}
.sm-container-shop-text{
  padding: 10rpx 6rpx;
  position: relative;
}

.sm-container-shop-handle{
  display: flex;
  align-items: center;
  height: 100%;
}

.sm-container-shop-handle-btn{
  margin: 0 10rpx;
}

.sm-container-edit{
  padding-top: 40rpx;
  background: #ffffff;
}

.sm-container-info-info{
  padding: 20rpx;
  font-size: 26rpx;
}

.sm-container-btn {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
}