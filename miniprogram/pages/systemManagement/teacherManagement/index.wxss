.teacherManagement-container{
  background: #ffffff;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.teacherManagement-container-handle{
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.teacherManagement-container-list{
  padding: 30rpx 0 30rpx 10rpx;
  height: 100%;
  overflow-y: scroll;
}

.teacherManagement-container-list-swipe{
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  background: #ffffff;
}

.teacherManagement-container-popup{
  padding-top: 80rpx;
  box-sizing: border-box;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.teacherManagement-container-popup-list{
  padding: 20rpx 10rpx;
  box-sizing: border-box;
  height: 100%;
  overflow-y: scroll;
}

.teacherManagement-container-popup-list-hint{
  width: 100%;
  padding: 10rpx;
  text-align: center;
  color: #e6eceb;
}

.teacherManagement-container-popup-list-checkbox{
  padding: 10rpx 0;
}

.teacherManagement-container-popup-btn{
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
}

.cell-group{
  width: 100%;
  display: block;
  padding-right: 40rpx;
  box-sizing: border-box;
}

.movable-area{
  width: 100%;
  /* height: calc(100vh - 72rpx); */
  display: block;
}

.movable-item{
  width: 100%;  
  height: 50px;  
  line-height: 50px;  
  text-align: center;  
  background-color: #f8f8f8;  
  margin-bottom: 10px;  
  position: absolute; 
}

.movable-item-swipe-cell{
  width: 100%;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }
