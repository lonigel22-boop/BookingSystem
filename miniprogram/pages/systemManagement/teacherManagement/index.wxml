<view class="teacherManagement-container">
  <view class="teacherManagement-container-handle">
    <van-field
        model:value="{{ teacherName }}"
        center
        clearable
        label=""
        placeholder="请输入昵称或者姓名"
        border="{{ false }}"
        use-button-slot
      >
      <van-button slot="button" size="small" type="primary" color="#3f6f70" bind:tap="searchTeachers">
        搜索
      </van-button>
    </van-field>
    <van-button class="login-container-btn-edit" color="#3f6f70" size="small" round hairline bindtap="addTeacher" custom-style="padding: 0 40rpx;">添加</van-button>
  </view>
  <view class="teacherManagement-container-list" id="teachers-list" >
    <scroll-view class="scroll-view" style="height: calc(100%)" scroll-y="true" 	show-scrollbar="{{true}}" enhanced="{{true}}" 	lower-threshold ='100' bindscrolltolower="getTeachers">

      <!-- <van-cell-group>
        <van-swipe-cell right-width="{{ 80 }}"  wx:for="{{teachers}}" wx:key="_id">
          <van-cell title="{{item.name ? item.name : item.nickName}}" value="{{item.shopName}}" />
          <view slot="right" class="teacherManagement-container-list-swipe">
            <van-button color="#e05a4f" size="small" data-data="{{item}}" bind:tap="seleteTeacher">删除</van-button>
          </view>
        </van-swipe-cell>
      </van-cell-group> -->

      <van-cell-group  class="cell-group">
        <movable-area class="movable-area" style="height: {{teachers.length * 92}}rpx">
          <movable-view wx:for="{{teachers}}" wx:key="_id"
          direction="all"  
          data-index="{{ index }}"  
          x="{{ item.x }}"  
          y="{{ item.y }}"  
          bindtouchstart="handleTouchStart"  
          bindtouchmove="handleMoveChange"  
          bindtouchend="handleMoveEnd"
          class="movable-item" 
          >
          <!-- {{ item.name ? item.name : item.nickName }} -->
            <van-swipe-cell right-width="{{ 80 }}"  class="movable-item-swipe-cell">
              <van-cell title="{{item.name ? item.name : item.nickName}}" value="{{item.shopName}}" />
              <view slot="right" class="teacherManagement-container-list-swipe">
                <van-button color="#e05a4f" size="small" data-data="{{item}}" bind:tap="seleteTeacher">删除</van-button>
              </view>
            </van-swipe-cell>
          </movable-view>
        </movable-area>
        <view class="teacherManagement-container-popup-list-hint" hidden="{{teacherHasMore}}">没有更多数据</view>
      </van-cell-group>

      
    </scroll-view>
  </view>

  <van-popup
    show="{{ showUser }}"
    round
    position="right"
    custom-style="height: 100%; width: 70%;"
    bind:close="onClose"
    closeable
  >
    <view class="teacherManagement-container-popup">
      <van-field
        model:value="{{ userName }}"
        center
        clearable
        label=""
        placeholder="请输入昵称或者姓名"
        border="{{ false }}"
        use-button-slot
      >
        <van-button slot="button" size="small" type="primary" color="#3f6f70" bind:tap="searchUsers">
          搜索
        </van-button>
      </van-field>

      <view class="teacherManagement-container-popup-list">
        <scroll-view style="height: calc(100%)" scroll-y="true" 	lower-threshold ='100' bindscrolltolower="getUsers">
          <van-checkbox-group value="{{ checkUsers }}" bind:change="checkUsersChange">
            <van-checkbox custom-class="teacherManagement-container-popup-list-checkbox" name="{{item._openid}}" checked-color="#3f6f70" wx:for="{{ userList }}" wx:key="_id">{{ item.name ? item.name : item.nickName }}</van-checkbox>
          </van-checkbox-group>
          <view class="teacherManagement-container-popup-list-hint" hidden="{{hasMore}}">没有更多数据</view>
        </scroll-view>
      </view>

      <view class="teacherManagement-container-popup-btn">
        <van-button slot="button" size="small" type="primary" color="#3f6f70" bind:tap="userToTeacher">
          添加
        </van-button>
      </view>
    </view>
  </van-popup>
</view>