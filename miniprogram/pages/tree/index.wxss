/* KSST 技能树 · 小程序手机样式（WXSS）
   刻意不用 color-mix()/CSS 变量：所有主题色由 JS 预算成具体 rgba 内联传入，
   避免老安卓 WebView 不支持导致卡片变灰。间距用 margin，不依赖 flex gap。 */

page {
  background: #f5f5f5;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-text-size-adjust: 100%;
}
.page {
  padding: 14px 12px 26px;
  padding-bottom: 34px;
  padding-bottom: calc(26px + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(600px 300px at 12% -6%, rgba(107,143,156,0.13), transparent 60%),
    radial-gradient(500px 260px at 88% 0%, rgba(224,90,79,0.1), transparent 62%), #f5f5f5;
}

/* ---------- 顶部 ---------- */
.hd-title { font-size: 23px; font-weight: 700; letter-spacing: .5px; color: #3f6f70; }
.hd-sub { font-size: 11.5px; color: #9aabaa; line-height: 1.6; margin-top: 7px; }

/* ---------- 昵称条 ---------- */
.mebar {
  margin-top: 14px; padding: 11px 13px; border: 1px solid #e6eceb; border-radius: 13px;
  background: #ffffff; display: flex; align-items: center;
}
.mebar-l { flex: 1; font-size: 12px; color: #9aabaa; }
.mebar-name { color: #333333; font-weight: 700; font-size: 13px; margin-left: 6px; }
.mebar-btn { flex: 0 0 auto; font-size: 12px; color: #ffffff; padding: 7px 14px; border-radius: 99px;
  background: linear-gradient(92deg,#5a8d89,#6f9e7b); }

/* ---------- 排行榜 ---------- */
.board { margin-top: 14px; background: #ffffff; border: 1px solid #e6eceb; border-radius: 15px;
  padding: 12px; position: relative; overflow: hidden; }
.board::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg,#c9a227,#e05a4f,#7a9a8f); }
.lbhead { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }
.lbtitle { font-size: 13.5px; font-weight: 700; margin-right: 8px; }
.lbsub { font-size: 10.5px; color: #9aabaa; flex: 1; }
.lbbtns { margin-left: 6px; }
.lbmini { display: inline-block; border: 1px solid #e6eceb; background: #ffffff; color: #9aabaa;
  border-radius: 99px; padding: 8px 12px; font-size: 11.5px; }
.lbrow { display: flex; flex-direction: row; white-space: nowrap; width: 100%; }
.lbcard { display: inline-block; flex: 0 0 auto; min-width: 96px; margin-right: 9px;
  border: 1px solid #e6eceb; background: #ffffff; border-radius: 12px; padding: 9px 11px; }
.lbcard.me { background: rgba(76,175,80,0.07); border-color: rgba(76,175,80,0.4); }
.lbrank { font-size: 10.5px; color: #9aabaa; font-weight: 700; }
.lbcard.r1 .lbrank { color: #c9a227; }
.lbcard.r2 .lbrank { color: #666666; }
.lbcard.r3 .lbrank { color: #b08968; }
.lbname { font-size: 12.5px; font-weight: 700; margin-top: 4px; max-width: 100px;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.lbscore { font-size: 12px; color: #333333; margin-top: 2px; font-weight: 700; }
.lbempty { font-size: 12px; color: #9aabaa; padding: 8px 0; line-height: 1.6; }
.lbme { margin-top: 10px; font-size: 11.5px; color: #9aabaa; line-height: 1.6; }
.lberr { font-size: 11px; color: #e05a4f; margin-top: 8px; line-height: 1.5; }

/* ---------- 统计 ---------- */
.stats { display: flex; flex-wrap: wrap; margin-top: 14px; }
.stat { width: calc(50% - 5px); box-sizing: border-box; border: 1px solid #e6eceb; background: #ffffff;
  border-radius: 12px; padding: 10px 12px; margin-bottom: 9px; }
.stat:nth-child(odd) { margin-right: 10px; }
.sl { display: block; font-size: 10.5px; color: #9aabaa; margin-bottom: 3px; }
.sv { display: block; font-size: 19px; font-weight: 700; color: #333333; }
.sv.green { color: #6f9e7b; }
.sv.ratio { font-size: 18px; color: #8aa88f; }
.sv.ratio .slash { font-size: 13px; color: #9aabaa; font-weight: 400; }
.sv.route { font-size: 12px; color: #6b8f9c; line-height: 1.45; margin-top: 3px; }
.progwrap { margin-top: 12px; height: 9px; background: #ffffff; border: 1px solid #e6eceb;
  border-radius: 99px; overflow: hidden; }
.progbar { height: 100%; background: linear-gradient(90deg,#6f9e7b,#7a9a8f,#6b8f9c);
  border-radius: 99px; color: #ffffff; font-size: 9px; font-weight: 700;
  display: flex; align-items: center; justify-content: flex-end; padding-right: 7px; box-sizing: border-box; }

/* ---------- 筛选条 ---------- */
.toolbar { display: flex; flex-direction: row; white-space: nowrap; width: 100%;
  margin: 16px -12px 10px; padding: 0 12px 6px; box-sizing: border-box; }
.fbtn { display: inline-block; flex: 0 0 auto; border: 1px solid #e6eceb; background: #ffffff;
  color: #9aabaa; padding: 9px 14px; border-radius: 99px; font-size: 12.5px; margin-right: 8px; }
.fbtn.on { background: linear-gradient(92deg,#5a8d89,#6f9e7b); color: #ffffff; border-color: transparent; }
.fbtn.reset { color: #e05a4f; border-color: #f3e9e8; }

/* ---------- 枝干 ---------- */
.tree { margin-top: 4px; }
.branch { background: #ffffff; border: 1px solid #e6eceb; border-radius: 16px;
  padding: 14px 12px 16px; margin-bottom: 16px; position: relative; overflow: hidden; }
.bhead { display: flex; align-items: center; margin-bottom: 13px; }
.bicon { font-size: 23px; width: 42px; height: 42px; flex: 0 0 42px; line-height: 42px; text-align: center;
  border-radius: 12px; border: 1px solid #e6eceb; margin-right: 10px; }
.btxt { flex: 1; min-width: 0; }
.bt { font-size: 15.5px; font-weight: 700; letter-spacing: .3px; }
.bs { font-size: 11.5px; color: #9aabaa; margin-top: 2px; line-height: 1.45; }
.bprog { flex: 0 0 58px; text-align: right; }
.bprogt { font-size: 11px; color: #9aabaa; }
.bprogbar { height: 6px; border-radius: 99px; background: #e6eceb; margin-top: 5px; overflow: hidden; }
.bprogfill { height: 100%; border-radius: 99px; }

/* ---------- 节点卡片 ---------- */
.nodes { display: block; }
.node { background: #ffffff; border: 1px solid #e6eceb; border-radius: 14px;
  padding: 14px; margin-bottom: 11px; position: relative; overflow: hidden; }
.node.st-locked { opacity: .5; }
.node.st-ready { border-color: #e6eceb; }
.node.glow { border-color: #6f9e7b; }
.node.boss { border-style: dashed; }
.node.ultra { background: linear-gradient(160deg, rgba(255,152,0,0.12), #ffffff); }
.nh { display: flex; align-items: center; margin-bottom: 6px; }
.nt { font-weight: 700; font-size: 15.5px; }
.badge { font-size: 10px; padding: 2px 7px; border-radius: 99px; margin-left: auto; }
.badge.boss { background: rgba(255,152,0,0.18); color: #c9a227; border: 1px solid rgba(255,152,0,0.35); }
.badge.ultra { background: rgba(255,152,0,0.22); color: #c9a227; border: 1px solid rgba(255,152,0,0.45); }
.badge.major { background: rgba(224,90,79,0.18); color: #e05a4f; border: 1px solid rgba(224,90,79,0.35); }
.badge.pick { background: rgba(255,152,0,0.18); color: #ff9800; border: 1px solid rgba(255,152,0,0.35); }
.none { font-size: 13px; color: #666666; line-height: 1.6; margin-bottom: 9px; }
.lock { font-size: 11.5px; color: #e05a4f; line-height: 1.5; margin-bottom: 9px; padding: 5px 8px;
  border-radius: 8px; background: rgba(224,90,79,0.09); }
.ratio { margin: 2px 0 10px; }
.rbar { display: flex; height: 7px; border-radius: 99px; overflow: hidden; background: rgba(63,111,112,0.034); }
.ra, .rb { display: block; height: 100%; }
.rb { background: rgba(63,111,112,0.05); }
.rmeta { font-size: 10.5px; color: #9aabaa; margin-top: 4px; }
.meta { margin-bottom: 10px; }
.reg { font-size: 11.5px; color: #9aabaa; border-left: 2px solid #6f9e7b; padding-left: 7px; line-height: 1.55; }
.acts { display: flex; }
.act { flex: 1; border-radius: 11px; padding: 11px 12px; font-size: 13.5px; font-weight: 600;
  text-align: center; min-height: 44px; line-height: 22px; box-sizing: border-box; color: #333333; }
.act.off { background: rgba(63,111,112,0.025); color: #9aabaa; }
.act.done { background: rgba(63,111,112,0.034); color: #6f9e7b; }

/* ---------- 底部说明 ---------- */
.foot { font-size: 10.5px; color: #e6eceb; line-height: 1.75; margin-top: 20px; padding: 0 4px 8px; }

/* ---------- 通用遮罩 ---------- */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 400;
  background: rgba(4,8,18,.78); display: flex; align-items: center; justify-content: center;
  padding: 14px; box-sizing: border-box; }

/* ---------- 详情浮层 ---------- */
.detailbox { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 300;
  background: #ffffff; display: flex; flex-direction: column;
  transform: translateY(100%); visibility: hidden;
  transition: transform .28s cubic-bezier(.4,0,.2,1); }
.detailbox.show { transform: translateY(0); visibility: visible; }
.detailbox.dragging { transition: none; }
.dtopbar { position: relative; flex: 0 0 auto; height: 52px; padding-top: 6px; box-sizing: border-box; }
.dgrab { position: absolute; left: 0; right: 0; top: 0; height: 26px;
  display: flex; align-items: center; justify-content: center; }
.dgrabbar { width: 42px; height: 4px; border-radius: 99px; background: rgba(63,111,112,0.101); }
.dclose { position: absolute; right: 12px; top: 8px; z-index: 3;
  border: 1px solid #e6eceb; background: #ffffff; color: #9aabaa;
  border-radius: 99px; padding: 8px 15px; font-size: 12.5px; }
.detail { flex: 1; min-height: 0; padding: 0 16px 10px; box-sizing: border-box; }
.dhead { display: flex; align-items: center; padding-bottom: 14px; margin-bottom: 14px;
  border-bottom: 1px solid #e6eceb; }
.dicon { font-size: 26px; width: 46px; height: 46px; flex: 0 0 46px; line-height: 46px; text-align: center;
  border-radius: 13px; border: 1px solid #e6eceb; margin-right: 12px; }
.dheadtxt { flex: 1; min-width: 0; }
.dtitle { font-size: 19px; font-weight: 800; }
.dsub { font-size: 12.5px; color: #9aabaa; margin-top: 3px; line-height: 1.5; }
.df, .dfull { background: #ffffff; border: 1px solid #e6eceb; border-radius: 13px;
  padding: 13px; margin-bottom: 11px; }
.fl { display: block; font-size: 11px; color: #7a9a8f; letter-spacing: 1px; margin-bottom: 7px; font-weight: 700; }
.fp { font-size: 13.5px; line-height: 1.7; color: #666666; }
.chips { display: flex; flex-wrap: wrap; }
.chip { font-size: 11.5px; padding: 5px 10px; border-radius: 99px; border: 1px solid;
  background: rgba(63,111,112,0.013); margin-right: 7px; margin-bottom: 7px; }
.dlock { font-size: 12.5px; color: #e05a4f; line-height: 1.6; padding: 10px 12px; border-radius: 11px;
  background: rgba(224,90,79,0.09); border: 1px solid rgba(224,90,79,0.2); margin-bottom: 10px; }
.dfoot { flex: 0 0 auto; display: flex; flex-wrap: wrap; padding: 12px 16px 14px;
  padding-bottom: 22px;
  padding-bottom: calc(14px + env(safe-area-inset-bottom));
  border-top: 1px solid #e6eceb; background: #ffffff; }
.dact { flex: 1 1 100%; min-height: 46px; line-height: 24px; text-align: center; border-radius: 11px;
  padding: 11px; font-size: 14px; font-weight: 700; color: #333333; margin-bottom: 9px; box-sizing: border-box; }
.dact.off { background: rgba(63,111,112,0.025); color: #9aabaa; }
.dact.sec { background: rgba(63,111,112,0.034); color: #666666; }

/* ---------- 答题弹层 ---------- */
.quiz { width: 100%; max-height: 82vh; overflow-y: auto; background: #ffffff;
  border: 1px solid #e6eceb; border-radius: 18px; padding: 18px 15px; box-sizing: border-box; }
.qhead { display: flex; align-items: center; }
.qtag { font-size: 12px; padding: 3px 11px; border-radius: 99px; letter-spacing: .5px; border: 1px solid; }
.qclose { margin-left: auto; color: #9aabaa; font-size: 20px; line-height: 1; padding: 0 4px; }
.qtitle { font-size: 16.5px; font-weight: 700; line-height: 1.45; margin: 10px 0 5px; }
.qlabel { font-size: 11.5px; color: #7a9a8f; margin-bottom: 6px; }
.qstem { font-size: 12.5px; color: #9aabaa; line-height: 1.6; margin-bottom: 14px; }
.qopts { display: block; }
.qopt { display: flex; align-items: center; min-height: 48px; padding: 13px 12px; margin-bottom: 9px;
  border: 1px solid #e6eceb; background: #ffffff; border-radius: 12px; box-sizing: border-box; }
.qopt.right { border-color: #6f9e7b; background: rgba(76,175,80,0.14); }
.qopt.wrong { border-color: #e05a4f; background: rgba(224,90,79,0.12); }
.qkey { flex: 0 0 26px; height: 26px; line-height: 26px; text-align: center; border-radius: 7px;
  border: 1px solid #e6eceb; font-size: 12px; font-weight: 700; color: #9aabaa;
  background: rgba(63,111,112,0.017); margin-right: 10px; }
.qopt.right .qkey { border-color: transparent; background: #6f9e7b; color: #333333; }
.qopt.wrong .qkey { border-color: transparent; background: #e05a4f; color: #333333; }
.qtext { flex: 1; font-size: 13.5px; line-height: 1.55; color: #666666; }
.qfeedback { font-size: 12.5px; line-height: 1.6; border-radius: 12px; padding: 11px 12px; margin-top: 4px; }
.qfeedback.ok { background: rgba(76,175,80,0.12); border: 1px solid rgba(76,175,80,0.35); color: #6f9e7b; }
.qfeedback.no { background: rgba(224,90,79,0.12); border: 1px solid rgba(224,90,79,0.35); color: #e05a4f; }
.qpending { font-size: 12px; color: #6b8f9c; line-height: 1.6; margin-top: 12px; }
.qbtnrow { display: flex; margin-top: 12px; }
.qbtn { flex: 1; min-height: 46px; line-height: 24px; text-align: center; border-radius: 99px; padding: 11px; font-size: 14px; font-weight: 700; }
.qbtn.ghost { background: rgba(63,111,112,0.034); color: #9aabaa; }

/* ---------- 改名弹层 ---------- */
.join, .confirm { width: 100%; background: #ffffff; border: 1px solid #e6eceb;
  border-radius: 16px; padding: 20px 16px 16px; box-sizing: border-box; }
.jtitle, .ctitle { font-size: 16.5px; font-weight: 700; margin-bottom: 6px; }
.jdesc, .cdesc { font-size: 12.5px; color: #9aabaa; line-height: 1.7; margin-bottom: 16px; }
.jinput { width: 100%; box-sizing: border-box; border: 1px solid #e6eceb; background: #ffffff;
  color: #333333; border-radius: 11px; padding: 12px 13px; font-size: 16px; min-height: 46px; }
.jerr { font-size: 12px; color: #e05a4f; min-height: 18px; line-height: 1.5; margin: 4px 0 8px; }
.jbtns, .cbtns { display: flex; }
.jbtn { flex: 1; min-height: 48px; line-height: 24px; text-align: center; border-radius: 11px;
  padding: 12px; font-size: 13.5px; font-weight: 700; color: #ffffff;
  background: linear-gradient(92deg,#5a8d89,#6f9e7b); margin-right: 9px; }
.jbtn.sec { background: rgba(63,111,112,0.034); color: #9aabaa; margin-right: 0; }
.cbtn { flex: 1; min-height: 48px; line-height: 24px; text-align: center; border-radius: 11px;
  padding: 12px; font-size: 14px; font-weight: 700; }
.cbtn.cancel { background: rgba(63,111,112,0.034); color: #9aabaa; margin-right: 9px; }
.cbtn.ok { background: #e05a4f; color: #333333; }

/* ---------- 老师：管理技能点按钮 ---------- */
.adminbar { margin-top: 12px; padding: 12px 14px; border-radius: 13px;
  background: linear-gradient(92deg, rgba(107,143,156,0.18), rgba(107,143,156,0.14));
  border: 1px solid #e6eceb; display: flex; align-items: center; }
.adminbar-t { font-size: 13.5px; font-weight: 700; color: #8aa88f; }
.adminbar-s { font-size: 10.5px; color: #9aabaa; margin-left: 8px; flex: 1; line-height: 1.4; }
.adminbar-arrow { font-size: 20px; color: #6b8f9c; margin-left: 6px; }

/* ---------- 解锁额度 / 我的老师 ---------- */
.creditbar { margin-top: 10px; padding: 11px 13px; border: 1px solid #e6eceb;
  border-radius: 13px; background: #ffffff; display: flex; align-items: center; }
.creditbar-l { flex: 1; min-width: 0; }
.creditbar-t { display: block; font-size: 12.5px; font-weight: 700; color: #6f9e7b; line-height: 1.5; }
.creditbar-s { display: block; font-size: 10.5px; color: #9aabaa; line-height: 1.5; margin-top: 3px; }
.creditbar-r { flex: 0 0 auto; margin-left: 8px; font-size: 11.5px; color: #8aa88f;
  border: 1px solid #e6eceb; border-radius: 99px; padding: 7px 11px; max-width: 110px;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.creditbar-edit { color: #9aabaa; margin-left: 3px; }
/* 已选定老师后：纯文本，不再像按钮一样可点 */
.creditbar-r.static { color: #5a8d89; border-color: #e6eceb; background: rgba(107,143,156,0.06); }

/* ---------- ★ v11 页面最下方：不可见但可点的后台热区 ----------
   没有任何背景 / 边框 / 文字，视觉上完全消失；保留足够高度便于点击，
   并避开 iPhone 手势条。只有滑到页面最底部才碰得到，不会误触。 */
.admin-hotzone { height: 96px; margin-top: 6px;
  margin-bottom: env(safe-area-inset-bottom); background: transparent; }

/* ---------- 选老师 ---------- */
.tpick { width: 100%; max-height: 78vh; display: flex; flex-direction: column;
  background: #ffffff; border: 1px solid #e6eceb; border-radius: 16px;
  padding: 20px 16px 16px; box-sizing: border-box; }
.tpick.small { height: 70vh; max-height: 70vh; overflow: hidden; }
.tpick.small > .jtitle, .tpick.small > .jdesc,
.tpick.small > .jbtns { flex: 0 0 auto; }
.tpick.small .tpicklist { flex: 1 1 auto; min-height: 0; height: 0;
  max-height: none; }
.tpickerr { font-size: 12px; color: #e05a4f; line-height: 1.6; margin: 2px 0 10px; }
.tpicklist { max-height: 46vh; margin-bottom: 12px; }
.titem { display: flex; align-items: center; min-height: 54px; padding: 10px 12px;
  margin-bottom: 9px; border: 1px solid #e6eceb; background: #ffffff;
  border-radius: 12px; box-sizing: border-box; }
.tavatar { width: 34px; height: 34px; line-height: 34px; text-align: center; flex: 0 0 34px;
  border-radius: 99px; background: rgba(107,143,156,0.2); color: #3f6f70; font-size: 11px;
  overflow: hidden; white-space: nowrap; margin-right: 10px; }
.titemname { flex: 1; font-size: 14px; font-weight: 600; color: #333333; }
.titemarrow { font-size: 18px; color: #9aabaa; }

/* ---------- 管理浮层 / 管理后台 ---------- */
.mask.inner { z-index: 460; }
/* ★ 管理弹层：固定高度 + flex 列布局。
   头部（标题 / 自加点 / 说明 / stepper / 搜索）不参与伸缩，
   名单 scroll-view 独占剩余高度，人数再多也只在弹层内部上下滑。 */
.manage { width: 100%; height: 88vh; max-height: 88vh;
  display: flex; flex-direction: column; overflow: hidden;
  background: #ffffff; border: 1px solid #e6eceb; border-radius: 18px;
  padding: 18px 15px 14px; box-sizing: border-box; }
.manage > .mhead, .manage > .mself-title, .manage > .mself,
.manage > .mnote, .manage > .mstep, .manage > .msearch,
.manage > .mloading { flex: 0 0 auto; }
.mhead { display: flex; align-items: center; margin-bottom: 12px; }
.mtitle { font-size: 16.5px; font-weight: 700; flex: 1; }
.mclose { font-size: 12.5px; color: #9aabaa; border: 1px solid #e6eceb;
  border-radius: 99px; padding: 7px 13px; }
.mtabs { display: flex; margin-bottom: 12px; }
.mself-title { font-size: 11.5px; color: #7f9b96; font-weight: 600; margin: 0 0 6px 2px; }
/* 给我自己：独立加点条 */
.mself { display: flex; align-items: center; padding: 10px 12px; margin-bottom: 10px;
  border: 1px solid #e6eceb; background: rgba(63,111,112,.10); border-radius: 12px; }
.mself-l { flex: 1; font-size: 12.5px; color: #666666; font-weight: 600; }
.mself-n { color: #7f9b96; font-weight: 700; margin-left: 4px; }
.mself-btns { display: flex; align-items: center; }
.mself-step { width: 46px; text-align: center; font-size: 11px; color: #7f9b96; }
.mtab { flex: 1; text-align: center; padding: 10px; font-size: 13px; border-radius: 10px;
  border: 1px solid #e6eceb; background: #ffffff; color: #9aabaa; margin-right: 9px; }
.mtab:last-child { margin-right: 0; }
.mtab.on { background: linear-gradient(92deg,#5a8d89,#6f9e7b); color: #ffffff; border-color: transparent; }
.mstep { display: flex; align-items: center; padding: 10px 12px; border-radius: 12px;
  background: #ffffff; border: 1px solid #e6eceb; margin-bottom: 9px; }
.mstep-l { flex: 1; font-size: 12.5px; color: #666666; }
.mstepper { display: flex; align-items: center; }
.mstepbtn { width: 34px; height: 34px; line-height: 32px; text-align: center; font-size: 19px;
  border-radius: 9px; border: 1px solid #e6eceb; color: #8aa88f; background: rgba(107,143,156,0.12); }
.mstepn { width: 44px; text-align: center; font-size: 16px; font-weight: 700; color: #333333; }
.mstep-r { margin-left: 8px; font-size: 10.5px; color: #9aabaa; }
.mnote { font-size: 11px; color: #9aabaa; line-height: 1.6; margin-bottom: 11px; }
/* ★ v10 后台名字搜索 */
.msearch { display: flex; align-items: center; gap: 8px; margin: 2px 0 10px;
  padding: 7px 10px; border-radius: 11px; border: 1px solid #e6eceb;
  background: rgba(107,143,156,0.07); }
.msearch-in { flex: 1; min-width: 0; height: 34px; font-size: 12.5px; color: #666666; }
.msearch-ph { color: #9aabaa; font-size: 12px; }
.msearch-clear { flex: 0 0 auto; width: 22px; height: 22px; line-height: 22px;
  text-align: center; border-radius: 50%; font-size: 12px;
  background: #e6eceb; color: #666666; }
.msearch-cnt { flex: 0 0 auto; font-size: 10.5px; color: #9aabaa; white-space: nowrap; }
.mloading { font-size: 12.5px; color: #9aabaa; padding: 20px 0; text-align: center; }
.mlist { flex: 1 1 auto; min-height: 0; height: 0; width: 100%; }
.mrow { display: flex; align-items: center; padding: 11px 12px; margin-bottom: 9px;
  border: 1px solid #e6eceb; background: #ffffff; border-radius: 12px; }
.mrowinfo { flex: 1; min-width: 0; }
.mname { font-size: 13.5px; font-weight: 700; color: #333333; }
.mtag { font-size: 10px; color: #6f9e7b; border: 1px solid rgba(76,175,80,0.35);
  border-radius: 99px; padding: 1px 6px; margin-left: 6px; font-weight: 400; }
.mtag.t { color: #ff9800; border-color: rgba(255,152,0,0.4); }
.mmeta { font-size: 11px; color: #9aabaa; margin-top: 4px; line-height: 1.5; }
.mbtns { display: flex; flex: 0 0 auto; margin-left: 8px; }
.mbtn { min-width: 38px; height: 38px; line-height: 36px; text-align: center; font-size: 19px;
  border-radius: 10px; margin-left: 6px; padding: 0 9px; font-weight: 700; }
.mbtn.minus { color: #e05a4f; border: 1px solid rgba(224,90,79,0.35); background: rgba(224,90,79,0.1); }
.mbtn.plus  { color: #6f9e7b; border: 1px solid rgba(76,175,80,0.35); background: rgba(76,175,80,0.1); }
.mbtn.edit { font-size: 12px; line-height: 38px; color: #8aa88f; border: 1px solid #e6eceb;
  background: rgba(107,143,156,0.12); }
/* 后台每行要放下 [−][＋][改归属]，用小一号 */
.mbtn.sm { min-width: 30px; height: 34px; line-height: 32px; font-size: 16px;
  padding: 0 6px; margin-left: 4px; }
.mbtn.edit.sm { font-size: 11px; line-height: 34px; }
.mempty { font-size: 12px; color: #9aabaa; text-align: center; padding: 20px 0; line-height: 1.6; }

/* ---------- toast ---------- */
.toast { position: fixed; left: 12px; right: 12px; bottom: 30px;
  bottom: calc(22px + env(safe-area-inset-bottom));
  z-index: 500; text-align: center; font-size: 12.5px; line-height: 1.5;
  padding: 11px 16px; border-radius: 14px; background: #3f6f70; color: #ffffff; border: 1px solid #6f9e7b; }


/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }
