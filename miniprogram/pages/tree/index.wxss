/* KSST 技能树 · 小程序手机样式（WXSS）
   刻意不用 color-mix()/CSS 变量：所有主题色由 JS 预算成具体 rgba 内联传入，
   避免老安卓 WebView 不支持导致卡片变灰。间距用 margin，不依赖 flex gap。 */

page {
  background: #0a0e1a;
  color: #e6ecff;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-text-size-adjust: 100%;
}
.page {
  padding: 14px 12px 26px;
  padding-bottom: 34px;
  padding-bottom: calc(26px + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(600px 300px at 12% -6%, rgba(91,120,255,.13), transparent 60%),
    radial-gradient(500px 260px at 88% 0%, rgba(255,93,122,.10), transparent 62%), #0a0e1a;
}

/* ---------- 顶部 ---------- */
.hd-title { font-size: 23px; font-weight: 700; letter-spacing: .5px; color: #a5c2ff; }
.hd-sub { font-size: 11.5px; color: #7d89a8; line-height: 1.6; margin-top: 7px; }

/* ---------- 昵称条 ---------- */
.mebar {
  margin-top: 14px; padding: 11px 13px; border: 1px solid #1e2740; border-radius: 13px;
  background: #0d1220; display: flex; align-items: center;
}
.mebar-l { flex: 1; font-size: 12px; color: #7d89a8; }
.mebar-name { color: #e6ecff; font-weight: 700; font-size: 13px; margin-left: 6px; }
.mebar-btn { flex: 0 0 auto; font-size: 12px; color: #fff; padding: 7px 14px; border-radius: 99px;
  background: linear-gradient(92deg,#6f7dff,#a06fff); }

/* ---------- 排行榜 ---------- */
.board { margin-top: 14px; background: #111726; border: 1px solid #1e2740; border-radius: 15px;
  padding: 12px; position: relative; overflow: hidden; }
.board::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg,#ffd24a,#ff9fb0,#8b9cff); }
.lbhead { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }
.lbtitle { font-size: 13.5px; font-weight: 700; margin-right: 8px; }
.lbsub { font-size: 10.5px; color: #7d89a8; flex: 1; }
.lbbtns { margin-left: 6px; }
.lbmini { display: inline-block; border: 1px solid #1e2740; background: #0d1220; color: #7d89a8;
  border-radius: 99px; padding: 8px 12px; font-size: 11.5px; }
.lbrow { display: flex; flex-direction: row; white-space: nowrap; width: 100%; }
.lbcard { display: inline-block; flex: 0 0 auto; min-width: 96px; margin-right: 9px;
  border: 1px solid #1e2740; background: #0d1220; border-radius: 12px; padding: 9px 11px; }
.lbcard.me { background: rgba(94,224,160,.07); border-color: rgba(94,224,160,.4); }
.lbrank { font-size: 10.5px; color: #7d89a8; font-weight: 700; }
.lbcard.r1 .lbrank { color: #ffd24a; }
.lbcard.r2 .lbrank { color: #c9d2e8; }
.lbcard.r3 .lbrank { color: #e0a878; }
.lbname { font-size: 12.5px; font-weight: 700; margin-top: 4px; max-width: 100px;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.lbscore { font-size: 12px; color: #fff; margin-top: 2px; font-weight: 700; }
.lbempty { font-size: 12px; color: #7d89a8; padding: 8px 0; line-height: 1.6; }
.lbme { margin-top: 10px; font-size: 11.5px; color: #7d89a8; line-height: 1.6; }
.lberr { font-size: 11px; color: #ff9fb0; margin-top: 8px; line-height: 1.5; }

/* ---------- 统计 ---------- */
.stats { display: flex; flex-wrap: wrap; margin-top: 14px; }
.stat { width: calc(50% - 5px); box-sizing: border-box; border: 1px solid #1e2740; background: #0d1220;
  border-radius: 12px; padding: 10px 12px; margin-bottom: 9px; }
.stat:nth-child(odd) { margin-right: 10px; }
.sl { display: block; font-size: 10.5px; color: #7d89a8; margin-bottom: 3px; }
.sv { display: block; font-size: 19px; font-weight: 700; color: #fff; }
.sv.green { color: #5ee0a0; }
.sv.route { font-size: 12px; color: #b07bff; line-height: 1.45; margin-top: 3px; }
.progwrap { margin-top: 12px; height: 9px; background: #0d1220; border: 1px solid #1e2740;
  border-radius: 99px; overflow: hidden; }
.progbar { height: 100%; background: linear-gradient(90deg,#5ee0a0,#4aa8ff,#b07bff);
  border-radius: 99px; color: #04120b; font-size: 9px; font-weight: 700;
  display: flex; align-items: center; justify-content: flex-end; padding-right: 7px; box-sizing: border-box; }

/* ---------- 筛选条 ---------- */
.toolbar { display: flex; flex-direction: row; white-space: nowrap; width: 100%;
  margin: 16px -12px 10px; padding: 0 12px 6px; box-sizing: border-box; }
.fbtn { display: inline-block; flex: 0 0 auto; border: 1px solid #1e2740; background: #0d1220;
  color: #7d89a8; padding: 9px 14px; border-radius: 99px; font-size: 12.5px; margin-right: 8px; }
.fbtn.on { background: linear-gradient(92deg,#6f7dff,#a06fff); color: #fff; border-color: transparent; }
.fbtn.reset { color: #ff9fb0; border-color: #3a2530; }

/* ---------- 枝干 ---------- */
.tree { margin-top: 4px; }
.branch { background: #111726; border: 1px solid #1e2740; border-radius: 16px;
  padding: 14px 12px 16px; margin-bottom: 16px; position: relative; overflow: hidden; }
.bhead { display: flex; align-items: center; margin-bottom: 13px; }
.bicon { font-size: 23px; width: 42px; height: 42px; flex: 0 0 42px; line-height: 42px; text-align: center;
  border-radius: 12px; border: 1px solid #1e2740; margin-right: 10px; }
.btxt { flex: 1; min-width: 0; }
.bt { font-size: 15.5px; font-weight: 700; letter-spacing: .3px; }
.bs { font-size: 11.5px; color: #7d89a8; margin-top: 2px; line-height: 1.45; }
.bprog { flex: 0 0 58px; text-align: right; }
.bprogt { font-size: 11px; color: #7d89a8; }
.bprogbar { height: 6px; border-radius: 99px; background: #1e2740; margin-top: 5px; overflow: hidden; }
.bprogfill { height: 100%; border-radius: 99px; }

/* ---------- 节点卡片 ---------- */
.nodes { display: block; }
.node { background: #0d1220; border: 1px solid #1e2740; border-radius: 14px;
  padding: 14px; margin-bottom: 11px; position: relative; overflow: hidden; }
.node.st-locked { opacity: .5; }
.node.st-ready { border-color: #3a4768; }
.node.glow { border-color: #5ee0a0; }
.node.boss { border-style: dashed; }
.node.ultra { background: linear-gradient(160deg, rgba(255,210,74,.12), #0d1220); }
.nh { display: flex; align-items: center; margin-bottom: 6px; }
.nt { font-weight: 700; font-size: 15.5px; }
.badge { font-size: 10px; padding: 2px 7px; border-radius: 99px; margin-left: auto; }
.badge.boss { background: rgba(255,210,74,.18); color: #ffd24a; border: 1px solid rgba(255,210,74,.35); }
.badge.ultra { background: rgba(255,210,74,.22); color: #ffd24a; border: 1px solid rgba(255,210,74,.45); }
.badge.major { background: rgba(255,93,122,.18); color: #ff9fb0; border: 1px solid rgba(255,93,122,.35); }
.badge.pick { background: rgba(255,180,84,.18); color: #ffc98a; border: 1px solid rgba(255,180,84,.35); }
.none { font-size: 13px; color: #b9c4df; line-height: 1.6; margin-bottom: 9px; }
.lock { font-size: 11.5px; color: #ff9fb0; line-height: 1.5; margin-bottom: 9px; padding: 5px 8px;
  border-radius: 8px; background: rgba(255,93,122,.09); }
.ratio { margin: 2px 0 10px; }
.rbar { display: flex; height: 7px; border-radius: 99px; overflow: hidden; background: rgba(255,255,255,.08); }
.ra, .rb { display: block; height: 100%; }
.rb { background: rgba(255,255,255,.12); }
.rmeta { font-size: 10.5px; color: #7d89a8; margin-top: 4px; }
.meta { margin-bottom: 10px; }
.reg { font-size: 11.5px; color: #7d89a8; border-left: 2px solid #5ee0a0; padding-left: 7px; line-height: 1.55; }
.acts { display: flex; }
.act { flex: 1; border-radius: 11px; padding: 11px 12px; font-size: 13.5px; font-weight: 600;
  text-align: center; min-height: 44px; line-height: 22px; box-sizing: border-box; color: #04120b; }
.act.off { background: rgba(255,255,255,.06); color: #5f6a85; }
.act.done { background: rgba(255,255,255,.08); color: #5ee0a0; }

/* ---------- 底部说明 ---------- */
.foot { font-size: 10.5px; color: #4a5470; line-height: 1.75; margin-top: 20px; padding: 0 4px 8px; }

/* ---------- 通用遮罩 ---------- */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 400;
  background: rgba(4,8,18,.78); display: flex; align-items: center; justify-content: center;
  padding: 14px; box-sizing: border-box; }

/* ---------- 详情浮层 ---------- */
.detailbox { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 300;
  background: #111726; display: flex; flex-direction: column;
  transform: translateY(100%); visibility: hidden;
  transition: transform .28s cubic-bezier(.4,0,.2,1); }
.detailbox.show { transform: translateY(0); visibility: visible; }
.detailbox.dragging { transition: none; }
.dtopbar { position: relative; flex: 0 0 auto; height: 52px; padding-top: 6px; box-sizing: border-box; }
.dgrab { position: absolute; left: 0; right: 0; top: 0; height: 26px;
  display: flex; align-items: center; justify-content: center; }
.dgrabbar { width: 42px; height: 4px; border-radius: 99px; background: rgba(255,255,255,.24); }
.dclose { position: absolute; right: 12px; top: 8px; z-index: 3;
  border: 1px solid #1e2740; background: #111726; color: #7d89a8;
  border-radius: 99px; padding: 8px 15px; font-size: 12.5px; }
.detail { flex: 1; min-height: 0; padding: 0 16px 10px; box-sizing: border-box; }
.dhead { display: flex; align-items: center; padding-bottom: 14px; margin-bottom: 14px;
  border-bottom: 1px solid #1e2740; }
.dicon { font-size: 26px; width: 46px; height: 46px; flex: 0 0 46px; line-height: 46px; text-align: center;
  border-radius: 13px; border: 1px solid #1e2740; margin-right: 12px; }
.dheadtxt { flex: 1; min-width: 0; }
.dtitle { font-size: 19px; font-weight: 800; }
.dsub { font-size: 12.5px; color: #7d89a8; margin-top: 3px; line-height: 1.5; }
.df, .dfull { background: #0d1220; border: 1px solid #1e2740; border-radius: 13px;
  padding: 13px; margin-bottom: 11px; }
.fl { display: block; font-size: 11px; color: #8b9cff; letter-spacing: 1px; margin-bottom: 7px; font-weight: 700; }
.fp { font-size: 13.5px; line-height: 1.7; color: #cdd6ee; }
.chips { display: flex; flex-wrap: wrap; }
.chip { font-size: 11.5px; padding: 5px 10px; border-radius: 99px; border: 1px solid;
  background: rgba(255,255,255,.03); margin-right: 7px; margin-bottom: 7px; }
.dlock { font-size: 12.5px; color: #ff9fb0; line-height: 1.6; padding: 10px 12px; border-radius: 11px;
  background: rgba(255,93,122,.09); border: 1px solid rgba(255,93,122,.2); margin-bottom: 10px; }
.dfoot { flex: 0 0 auto; display: flex; flex-wrap: wrap; padding: 12px 16px 14px;
  padding-bottom: 22px;
  padding-bottom: calc(14px + env(safe-area-inset-bottom));
  border-top: 1px solid #1e2740; background: #111726; }
.dact { flex: 1 1 100%; min-height: 46px; line-height: 24px; text-align: center; border-radius: 11px;
  padding: 11px; font-size: 14px; font-weight: 700; color: #04120b; margin-bottom: 9px; box-sizing: border-box; }
.dact.off { background: rgba(255,255,255,.06); color: #5f6a85; }
.dact.sec { background: rgba(255,255,255,.08); color: #cdd6ee; }

/* ---------- 答题弹层 ---------- */
.quiz { width: 100%; max-height: 82vh; overflow-y: auto; background: #111726;
  border: 1px solid #1e2740; border-radius: 18px; padding: 18px 15px; box-sizing: border-box; }
.qhead { display: flex; align-items: center; }
.qtag { font-size: 12px; padding: 3px 11px; border-radius: 99px; letter-spacing: .5px; border: 1px solid; }
.qclose { margin-left: auto; color: #7d89a8; font-size: 20px; line-height: 1; padding: 0 4px; }
.qtitle { font-size: 16.5px; font-weight: 700; line-height: 1.45; margin: 10px 0 5px; }
.qlabel { font-size: 11.5px; color: #8b9cff; margin-bottom: 6px; }
.qstem { font-size: 12.5px; color: #7d89a8; line-height: 1.6; margin-bottom: 14px; }
.qopts { display: block; }
.qopt { display: flex; align-items: center; min-height: 48px; padding: 13px 12px; margin-bottom: 9px;
  border: 1px solid #1e2740; background: #0d1220; border-radius: 12px; box-sizing: border-box; }
.qopt.right { border-color: #5ee0a0; background: rgba(94,224,160,.14); }
.qopt.wrong { border-color: #ff5d7a; background: rgba(255,93,122,.12); }
.qkey { flex: 0 0 26px; height: 26px; line-height: 26px; text-align: center; border-radius: 7px;
  border: 1px solid #1e2740; font-size: 12px; font-weight: 700; color: #7d89a8;
  background: rgba(255,255,255,.04); margin-right: 10px; }
.qopt.right .qkey { border-color: transparent; background: #5ee0a0; color: #04120b; }
.qopt.wrong .qkey { border-color: transparent; background: #ff5d7a; color: #fff; }
.qtext { flex: 1; font-size: 13.5px; line-height: 1.55; color: #d7deef; }
.qfeedback { font-size: 12.5px; line-height: 1.6; border-radius: 12px; padding: 11px 12px; margin-top: 4px; }
.qfeedback.ok { background: rgba(94,224,160,.12); border: 1px solid rgba(94,224,160,.35); color: #a8f0c8; }
.qfeedback.no { background: rgba(255,93,122,.12); border: 1px solid rgba(255,93,122,.35); color: #ffb3c0; }
.qpending { font-size: 12px; color: #c9a5ff; line-height: 1.6; margin-top: 12px; }
.qbtnrow { display: flex; margin-top: 12px; }
.qbtn { flex: 1; min-height: 46px; line-height: 24px; text-align: center; border-radius: 99px; padding: 11px; font-size: 14px; font-weight: 700; }
.qbtn.ghost { background: rgba(255,255,255,.08); color: #7d89a8; }

/* ---------- 改名弹层 ---------- */
.join, .confirm { width: 100%; background: #111726; border: 1px solid #1e2740;
  border-radius: 16px; padding: 20px 16px 16px; box-sizing: border-box; }
.jtitle, .ctitle { font-size: 16.5px; font-weight: 700; margin-bottom: 6px; }
.jdesc, .cdesc { font-size: 12.5px; color: #7d89a8; line-height: 1.7; margin-bottom: 16px; }
.jinput { width: 100%; box-sizing: border-box; border: 1px solid #1e2740; background: #0d1220;
  color: #e6ecff; border-radius: 11px; padding: 12px 13px; font-size: 16px; min-height: 46px; }
.jerr { font-size: 12px; color: #ff9fb0; min-height: 18px; line-height: 1.5; margin: 4px 0 8px; }
.jbtns, .cbtns { display: flex; }
.jbtn { flex: 1; min-height: 48px; line-height: 24px; text-align: center; border-radius: 11px;
  padding: 12px; font-size: 13.5px; font-weight: 700; color: #fff;
  background: linear-gradient(92deg,#6f7dff,#a06fff); margin-right: 9px; }
.jbtn.sec { background: rgba(255,255,255,.08); color: #7d89a8; margin-right: 0; }
.cbtn { flex: 1; min-height: 48px; line-height: 24px; text-align: center; border-radius: 11px;
  padding: 12px; font-size: 14px; font-weight: 700; }
.cbtn.cancel { background: rgba(255,255,255,.08); color: #7d89a8; margin-right: 9px; }
.cbtn.ok { background: #ff5d7a; color: #fff; }

/* ---------- toast ---------- */
.toast { position: fixed; left: 12px; right: 12px; bottom: 30px;
  bottom: calc(22px + env(safe-area-inset-bottom));
  z-index: 500; text-align: center; font-size: 12.5px; line-height: 1.5;
  padding: 11px 16px; border-radius: 14px; background: #111726; color: #fff; border: 1px solid #5ee0a0; }
