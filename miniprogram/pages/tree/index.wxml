<view class="page">

  <view class="hd">
    <view class="hd-title">KSST 演唱技能树</view>
    <view class="hd-sub">邝氏演唱演讲训练体系 · 每节课点亮一个技能点</view>
  </view>

  <!-- 榜单昵称：直接读 users.name（在「我的 → 个人信息」里改），师生一致 -->
  <view class="mebar">
    <view class="mebar-l">榜单昵称 <text class="mebar-name">{{myName || '未设置'}}</text></view>
    <view class="mebar-btn" bindtap="openName">去改名字 ›</view>
  </view>

  <!-- 老师专属：管理技能点（榜单显示与排名仍师生一致） -->
  <view class="adminbar" wx:if="{{isTeacher}}" bindtap="openManage" data-tab="credits">
    <text class="adminbar-t">⚙ 管理技能点</text>
    <text class="adminbar-s">给我和我的学生发放 / 收回解锁额度</text>
    <text class="adminbar-arrow">›</text>
  </view>

  <!-- 解锁额度 / 我的老师（师生都显示，只是内容不同） -->
  <view class="creditbar">
    <view class="creditbar-l">
      <text class="creditbar-t">🔓 {{creditLeftText || '正在读取解锁额度…'}}</text>
      <text class="creditbar-s">每点亮 1 节课消耗 1 点额度；撤销或清空后额度自动恢复</text>
    </view>
    <!-- ★ 未选老师的人（师生都要）可点首次选取；选完以后本人不能再改，需老师在管理后台调整 -->
    <view class="creditbar-r" wx:if="{{!teacherPicked}}" bindtap="openTeacherPicker">
      选择老师 <text class="creditbar-edit">选</text>
    </view>
    <view class="creditbar-r static" wx:if="{{!isTeacher && teacherPicked}}">
      老师：{{myTeacherName || '已选定'}}
    </view>
    <!-- ★ 老师给自己加点统一走「⚙ 管理技能点」弹层里的「① 先给自己加点」，
         额度条这里不再重复放入口 -->
  </view>

  <!-- 排行榜 -->
  <view class="board">
    <view class="lbhead">
      <view class="lbtitle">🏆 学习榜</view>
      <view class="lbsub">每点亮 1 节课 +1 分，撤销 -1 分</view>
      <view class="lbbtns"><view class="lbmini" bindtap="refreshBoard">↻ 刷新</view></view>
    </view>

    <!-- 师生一致的榜单：Top10 横滑 + 我的排名条 -->
    <scroll-view scroll-x class="lbrow" wx:if="{{boardTop.length > 0}}">
      <view class="lbcard {{item.me ? 'me' : ''}} r{{item.rank}}" wx:for="{{boardTop}}" wx:key="k">
        <view class="lbrank">{{item.medal}} 第 {{item.rank}} 名</view>
        <view class="lbname">{{item.name}}{{item.me ? ' · 我' : ''}}</view>
        <view class="lbscore">{{item.score}} 分</view>
      </view>
    </scroll-view>
    <view class="lbempty" wx:else>{{boardLoading ? '正在读取榜单…' : '还没有人上榜，来当第一名 🌱'}}</view>
    <view class="lbme">{{boardMeText}}</view>
    <view class="lberr" wx:if="{{boardErr}}">{{boardErr}}</view>
  </view>

  <!-- 统计：第一格显示「已用 / 已解锁」，跟额度制对齐 -->
  <view class="stats">
    <view class="stat"><text class="sl">已用 / 已解锁</text><text class="sv ratio">{{statLit}}<text class="slash"> / </text>{{myCredits}}</text></view>
    <view class="stat"><text class="sl">已点亮</text><text class="sv green">{{statLit}}</text></view>
    <view class="stat"><text class="sl">通关成就</text><text class="sv">{{statExam}}</text></view>
    <view class="stat"><text class="sl">路线</text><text class="sv route">气息→初级→中级→高级</text></view>
  </view>
  <view class="progwrap"><view class="progbar" style="width:{{prog}}%">{{prog}}%</view></view>

  <!-- 筛选条 -->
  <scroll-view scroll-x class="toolbar">
    <view class="fbtn {{filter === item.k ? 'on' : ''}}" wx:for="{{filters}}" wx:key="k"
          data-k="{{item.k}}" bindtap="onFilter">{{item.t}}</view>
    <view class="fbtn reset" bindtap="openConfirm">🗑 清空进度</view>
  </scroll-view>

  <!-- 技能树 -->
  <view class="tree">
    <view class="branch" wx:for="{{visibleBranches}}" wx:for-item="b" wx:key="id" style="border-left:3px solid {{b.c}}">
      <view class="bhead">
        <view class="bicon" style="background:{{b.cA16}};border-color:{{b.cA35}}">{{b.icon}}</view>
        <view class="btxt">
          <view class="bt">{{b.t}}</view>
          <view class="bs">{{b.sub}}</view>
        </view>
        <view class="bprog">
          <text class="bprogt">{{b.lit}}/{{b.total}}</text>
          <view class="bprogbar"><view class="bprogfill" style="width:{{b.pct}}%;background:{{b.c}}"></view></view>
        </view>
      </view>
      <view class="nodes">
        <view class="node {{n.cls}}" style="{{n.nodeStyle}}" wx:for="{{b.nodes}}" wx:for-item="n" wx:key="id"
              data-id="{{n.id}}" bindtap="onCardTap">
          <view class="nh">
            <text class="nt">{{n.n}}</text>
            <text class="badge {{n.badgeType}}" wx:if="{{n.badge}}">{{n.badge}}</text>
          </view>
          <view class="none">{{n.one}}</view>
          <view class="lock" wx:if="{{n.lock}}">{{n.lock}}</view>
          <view class="ratio" wx:if="{{n.hasRatio}}">
            <view class="rbar">
              <view class="ra" style="width:{{n.ratioA}}%;background:{{n.col}}"></view>
              <view class="rb" style="width:{{n.ratioB}}%"></view>
            </view>
            <view class="rmeta">{{n.ratioText}}</view>
          </view>
          <view class="meta"><text class="reg" style="border-left-color:{{n.col}}">{{n.reg}}</text></view>
          <view class="acts">
            <view class="act {{n.btnCls}}" style="{{n.btnStyle}}" data-id="{{n.id}}" data-act="{{n.btnAct}}" catchtap="onNodeAct">{{n.btnText}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="foot">
    <view>气:声比例沿用图⑤口径；身体部位能量对应图①参与标记，均为教学化表达。</view>
    <view>规则：初级线点满 → 初级考核 → 中级选 3 种风格 → 中级考核 → 三选一专攻 → 高级考核 → 隐藏果实全开。</view>
  </view>

  <!-- ★ 管理后台入口：完全不可见的透明热区，放在页面最下方（foot 之后）。
       滑到页面最底部、在这块空白处点一下即可进入；不是滑动手势，不需要连划。
       学生连这块热区都不渲染；openAdmin 与云端 adminList / adminSetTeacher
       仍各有一层 isTeacher 校验，三层都绕不过。 -->
  <view class="admin-hotzone" wx:if="{{isTeacher}}" bindtap="openAdmin"></view>

  <!-- 详情浮层（支持往下滑退出） -->
  <view class="detailbox {{detailShow ? 'show' : ''}} {{detailDragging ? 'dragging' : ''}}"
        style="{{detailDragStyle}}"
        bindtouchstart="onDTouchStart" bindtouchmove="onDTouchMove"
        bindtouchend="onDTouchEnd" bindtouchcancel="onDTouchEnd">
    <view class="dtopbar">
      <view class="dgrab"><view class="dgrabbar"></view></view>
      <view class="dclose" catchtap="closeDetail">✕ 关闭</view>
    </view>
    <scroll-view scroll-y class="detail" bindscroll="onDetailScroll" scroll-top="{{detailScrollTop}}">
      <block wx:if="{{d}}">
        <view class="dhead">
          <view class="dicon" style="background:{{d.colA18}};border-color:{{d.colA35}}">{{d.icon}}</view>
          <view class="dheadtxt">
            <view class="dtitle">{{d.n}}</view>
            <view class="dsub">{{d.one}}</view>
          </view>
        </view>
        <view class="df"><view class="fl">🎯 本课学什么</view><view class="fp">{{d.doe}}</view></view>
        <view class="df"><view class="fl">✨ 点亮后习得</view><view class="fp">{{d.unlock}}</view></view>
        <view class="dfull"><view class="fl">🎤 老师说</view><view class="fp">{{d.reg}}</view></view>
        <view class="dfull" wx:if="{{d.hasRatio}}">
          <view class="rbar">
            <view class="ra" style="width:{{d.ratioA}}%;background:{{d.col}}"></view>
            <view class="rb" style="width:{{d.ratioB}}%"></view>
          </view>
          <view class="rmeta">{{d.ratioText}}</view>
        </view>
        <view class="dfull">
          <view class="fl">🧬 参与部位</view>
          <view class="chips">
            <text class="chip" wx:for="{{d.ana}}" wx:for-item="a" wx:key="*this"
                  style="border-color:{{d.colA35}};color:{{d.col}}">{{a}}</text>
          </view>
        </view>
        <view class="dlock" wx:if="{{d.lock}}">{{d.lock}}</view>
      </block>
    </scroll-view>
    <view class="dfoot">
      <view class="dact {{d.btnCls}}" style="{{d.btnStyle}}" wx:if="{{d}}" data-act="{{d.btnAct}}" bindtap="onDetailAct">{{d.btnText}}</view>
      <view class="dact sec" wx:if="{{d.extraBtn}}" data-act="{{d.extraBtn.act}}" bindtap="onDetailAct">{{d.extraBtn.text}}</view>
    </view>
  </view>

  <!-- 答题弹层 -->
  <view class="mask" wx:if="{{quizShow}}" bindtap="closeQuiz" catchtouchmove="noop">
    <view class="quiz" catchtap="noop">
      <view class="qhead">
        <text class="qtag" style="color:{{quizCol}};border-color:{{quizColA40}};background:{{quizColA12}}">{{quizTag}}</text>
        <text class="qclose" catchtap="closeQuiz">×</text>
      </view>
      <view class="qtitle">{{quizTitle}}</view>
      <view class="qlabel">{{quizLabel}}</view>
      <view class="qstem">{{quizStem}}</view>
      <view class="qopts">
        <view class="qopt {{item.cls}}" wx:for="{{quizOpts}}" wx:key="k" data-idx="{{index}}" bindtap="onOptTap">
          <view class="qkey">{{item.key}}</view>
          <view class="qtext">{{item.text}}</view>
        </view>
      </view>
      <view class="qfeedback {{quizFeedbackType}}" wx:if="{{quizFeedback}}">{{quizFeedback}}</view>
      <view class="qpending" wx:if="{{quizPending}}">📝 该课程暂无正式题库（知识 / 技术 / 态度三关待定），点任意选项即可直接点亮</view>
      <view class="qbtnrow"><view class="qbtn ghost" catchtap="closeQuiz">取消</view></view>
    </view>
  </view>

  <!-- 改名统一走「我的 → 个人信息」页（editUsers → users 表），此处不再另设弹层 -->

  <!-- 清空进度确认 -->
  <view class="mask" wx:if="{{confirmShow}}" bindtap="closeConfirm" catchtouchmove="noop">
    <view class="confirm" catchtap="noop">
      <view class="ctitle">🗑 清空进度？</view>
      <view class="cdesc">将清除云端与本机所有已点亮技能点、选学、专攻与「曾点亮过」记录，榜单分数同步归零。清空后所有课程都需重新答题，此操作不可撤销。</view>
      <view class="cbtns">
        <view class="cbtn cancel" bindtap="closeConfirm">取消</view>
        <view class="cbtn ok" bindtap="doReset">确认清空</view>
      </view>
    </view>
  </view>

  <!-- 选择老师（★ 师生都要；本人点选过才进榜单） -->
  <view class="mask" wx:if="{{teacherPickShow}}" catchtouchmove="noop">
    <view class="tpick" catchtap="noop">
      <view class="jtitle">👩‍🏫 选择你的老师</view>
      <view class="jdesc">★ 老师与学生都需要选好自己的老师，才能进入技能树排行榜。选好后老师也能在管理页给你发放解锁技能点。老师可在名单里选「自己」。</view>
      <view class="tpickerr" wx:if="{{teacherErr}}">{{teacherErr}}</view>
      <scroll-view scroll-y class="tpicklist" catchtouchmove="noop">
        <view class="titem" wx:for="{{teachers}}" wx:key="id"
              data-id="{{item.id}}" data-name="{{item.name}}" bindtap="pickTeacher">
          <view class="tavatar">{{item.name}}</view>
          <view class="titemname">{{item.name}}</view>
          <view class="titemarrow">›</view>
        </view>
      </scroll-view>
      <view class="jbtns"><view class="jbtn sec" bindtap="closeTeacherPicker">稍后再选</view></view>
    </view>
  </view>

  <!-- 管理技能点 / 管理后台（两个入口：顶端按钮进 credits，页面底部老师按钮进 admin） -->
  <view class="mask" wx:if="{{manageShow}}" bindtap="closeManage" catchtouchmove="noop">
    <view class="manage" catchtap="noop">
      <view class="mhead">
        <view class="mtitle">{{manageTab === 'admin' ? '🛠 管理后台 · 全部学生' : '⚙ 管理技能点'}}</view>
        <view class="mclose" catchtap="closeManage">✕</view>
      </view>
      <!-- ★ 管理弹层里没有切换到后台的 tab：
           后台只能从「页面最下方 · 仅老师可点」的透明热区进入。 -->

      <!-- 技能点：调整数量 stepper + 每人 +/- -->
      <block wx:if="{{manageTab === 'credits'}}">
        <!-- ★ 给自己加点的独立入口，不依赖下面的列表是否加载成功 -->
        <view class="mself-title">① 先给自己加点（不依赖下面的学生列表）</view>
        <view class="mself">
          <view class="mself-l">给我自己 <text class="mself-n">{{myCredits}} 点</text></view>
          <view class="mself-btns">
            <view class="mbtn minus" data-sign="-1" bindtap="onSelfAdjust">−</view>
            <view class="mself-step">{{stepN}} 点</view>
            <view class="mbtn plus" data-sign="1" bindtap="onSelfAdjust">＋</view>
          </view>
        </view>
        <view class="mnote">这里只列出「本人主动选了你」的学生；上限 {{courseTotal}} 点，收回不会低于该人已点亮数。老师初始也是 0 点，要先给自己发。</view>
      </block>
      <view class="mnote" wx:else>这里只列出符合上榜条件的人（进过技能树 + 本人选过老师），与榜单同一规则；可给任意人加减技能点、改归属。</view>

      <!-- 两个页签共用的调整数量：普通管理、后台管理都按这个 N 加减 -->
      <view class="mstep">
        <view class="mstep-l">本次调整数量</view>
        <view class="mstepper">
          <view class="mstepbtn" bindtap="onStepMinus">−</view>
          <view class="mstepn">{{stepN}}</view>
          <view class="mstepbtn" bindtap="onStepPlus">＋</view>
        </view>
        <view class="mstep-r">点 1–{{courseTotal}}</view>
      </view>

      <view class="mloading" wx:if="{{manageLoading}}">正在读取…</view>

      <!-- 技能点列表：我 + 我的学生 -->
      <scroll-view scroll-y class="mlist" wx:if="{{manageTab === 'credits' && !manageLoading}}" catchtouchmove="noop">
        <view class="mrow" wx:for="{{manageList}}" wx:key="uid">
          <view class="mrowinfo">
            <view class="mname">{{item.name}}<text class="mtag" wx:if="{{item.me}}">我</text><text class="mtag t" wx:if="{{item.isTeacher}}">老师</text></view>
            <view class="mmeta">已点亮 {{item.score}} · 已发 {{item.credits}} 点 · 剩余 {{item.left}} 节</view>
          </view>
          <view class="mbtns">
            <view class="mbtn minus" data-uid="{{item.uid}}" data-sign="-1" bindtap="onCreditAdjust">−</view>
            <view class="mbtn plus" data-uid="{{item.uid}}" data-sign="1" bindtap="onCreditAdjust">＋</view>
          </view>
        </view>
        <view class="mempty" wx:if="{{manageList.length === 0}}">名下还没有学生。学生在技能树里自己选了你之后会出现在这里。</view>
      </scroll-view>
      <!-- ★ 后台：名单与榜单同规则 + 按名字即时搜索 -->
      <view class="msearch" wx:if="{{manageTab === 'admin' && !manageLoading}}">
        <input class="msearch-in" type="text" value="{{adminSearch}}"
               placeholder="输入名字搜索（学生或老师）" placeholder-class="msearch-ph"
               confirm-type="search" bindinput="onAdminSearch" />
        <view class="msearch-clear" wx:if="{{adminSearch}}" bindtap="clearAdminSearch">✕</view>
        <view class="msearch-cnt">{{adminMatched}} / {{adminTotal}} 人</view>
      </view>

      <scroll-view scroll-y class="mlist" wx:if="{{manageTab === 'admin' && !manageLoading}}" catchtouchmove="noop">
        <view class="mrow" wx:for="{{adminList}}" wx:key="uid">
          <view class="mrowinfo">
            <view class="mname">{{item.name}}<text class="mtag" wx:if="{{item.me}}">我</text><text class="mtag t" wx:if="{{item.isTeacher}}">老师</text></view>
            <view class="mmeta">老师：{{item.teacherName || '未绑定'}} · {{item.score}} 分 · {{item.credits}} 点 · 剩余 {{item.left}} 节</view>
          </view>
          <view class="mbtns">
            <view class="mbtn sm minus" data-uid="{{item.uid}}" data-sign="-1" bindtap="onAdminCreditAdjust">−</view>
            <view class="mbtn sm plus" data-uid="{{item.uid}}" data-sign="1" bindtap="onAdminCreditAdjust">＋</view>
            <view class="mbtn sm edit" data-uid="{{item.uid}}" data-name="{{item.name}}" bindtap="openAdminPick">改归属</view>
          </view>
        </view>
        <view class="mempty" wx:if="{{adminList.length === 0 && adminTotal === 0}}">
          还没有符合上榜条件的人（需进过技能树且本人选过老师）。
        </view>
        <view class="mempty" wx:if="{{adminList.length === 0 && adminTotal > 0}}">
          没有匹配「{{adminSearch}}」的人，点 ✕ 清空搜索。
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 后台改归属：老师名单选择 -->
  <view class="mask inner" wx:if="{{adminPickShow}}" bindtap="closeAdminPick" catchtouchmove="noop">
    <view class="tpick small" catchtap="noop">
      <view class="jtitle">改归属 · {{adminPickName}}</view>
      <view class="jdesc">选一位老师，该学生的技能点管理权会归到这位老师名下。</view>
      <scroll-view scroll-y class="tpicklist" catchtouchmove="noop">
        <view class="titem" wx:for="{{teachers}}" wx:key="id"
              data-id="{{item.id}}" data-name="{{item.name}}" bindtap="pickAdminTeacher">
          <view class="titemname">{{item.name}}</view>
          <view class="titemarrow">›</view>
        </view>
        <view class="titem" bindtap="clearAdminTeacher">
          <view class="titemname">移出归属（无老师）</view>
        </view>
      </scroll-view>
      <view class="jbtns"><view class="jbtn sec" bindtap="closeAdminPick">取消</view></view>
    </view>
  </view>

  <!-- toast -->
  <view class="toast {{toastShow ? 'in' : ''}}" wx:if="{{toastShow}}" style="border-color:{{toastCol}}">{{toastMsg}}</view>
</view>
