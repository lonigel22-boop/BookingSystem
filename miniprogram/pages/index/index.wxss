.container { 
  padding: 20rpx; 
} 
 
.content-header { 
  width: 100%; 
  height: 200rpx; 
  padding: 20rpx; 
  background: #000; 
} 
 
.content-header.container-header-img { 
  width: 100%; 
  height: 100%; 
} 
 
.content-header.container-header-shop { 
  width: 100%; 
  padding: 0rpx; 
  box-sizing: border-box; 
  margin: 0 auto; 
  background: #fff; 
} 
 
.content-header.container-header-info { 
  padding: 20rpx; 
  font-size: 28rpx; 
} 
 
.content-header.container-header-info.container-header-info-text { 
  padding: 10rpx 6rpx; 
  position: relative; 
} 
 
.content-header.container-header-info.container-header-info-text image { 
  width: 40rpx; 
  height: 40rpx; 
  position: absolute; 
  right: 0; 
} 
 
.container-teacher { 
  margin-top: 290rpx; 
  padding: 20rpx; 
  display: flex; 
  justify-content: space-between; 
  width: 100%; 
  color: #3a4c41; 
  font-size: 36rpx; 
  font-weight: 600; 
}

 
 
.container-swiper { 
  width: 100%; 
  background: #fff; 
  padding: 20rpx; 
  box-sizing: border-box; 
} 
 
.container-swiper-item { 
  display: flex; 
  align-items: center; 
} 
 
.container-swiper-item-text { 
  padding: 20rpx; 
  font-size: 28rpx; 
  flex: 1; 
} 
 
.container-swiper-item-text-item { 
  padding: 6rpx; 
} 
 
.container-swiper-item-text-overflow { 
  display: -webkit-box; 
  -webkit-line-clamp: 3; 
  -webkit-box-orient: vertical; 
  overflow: hidden; 
  text-overflow: ellipsis; 
} 
 
.container-swiper-item-text-p { 
  padding: 6rpx; 
} 
 
.container-swiper-item-img { 
  width: 200rpx; 
  height: 200rpx; 
  border-radius: 50%; 
  box-shadow: 0rpx 0rpx 20rpx 10rpx #e0e0e0; 
} 
 
.index-dialog-class-view { 
  text-align: center; 
  padding: 10rpx; 
} 
 
.container-info { 
  text-align: center; 
} 
 
.container-info-img { 
  width: 100rpx; 
  height: 100rpx; 
  border-radius: 50%; 
  box-shadow: 0 0 40rpx #cdcdcd; 
} 
 
.container-info-text { 
  padding: 20rpx; 
} 
 
.container-list { 
  width: 100%; 
}

/* 课程详情区域样式 */
.course-detail-section {
  width: 100%;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  display: block;
  box-sizing: border-box;
}

.day-detail-header {
  font-size: 32rpx;
  color: #3f6f70;
  font-weight: bold;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #eee;
  text-align: center;
}

.day-detail-content {
  padding-top: 16rpx;
}

.course-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.course-time-section {
  width: 180rpx;
}

.course-time {
  font-size: 32rpx;
  color: #3f6f70;
  font-weight: bold;
  text-align: center;
}

.course-student {
  font-size: 24rpx;
  color: #3f6f70;
  margin-top: 8rpx;
  text-align: center;
}

.course-info {
  flex: 1;
}

.course-title {
  font-size: 28rpx;
  color: #333;
}

.course-location {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.no-course {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}