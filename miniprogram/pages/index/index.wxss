.container { 
  padding: 20rpx; 
} 
 
.content-header { 
  width: 100%; 
  height: 200rpx; 
  padding: 20rpx; 
  background: #ffffff; 
} 
 
.content-header.container-header-img { 
  width: 100%; 
  height: 100%; 
} 
 
.content-header.container-header-shop { 
  width: 100%; 
  padding: 0rpx; 
  box-sizing: border-box; 
  margin: 0 auto; 
  background: #ffffff; 
} 
 
.content-header.container-header-info { 
  padding: 20rpx; 
  font-size: 28rpx; 
} 
 
.content-header.container-header-info.container-header-info-text { 
  padding: 10rpx 6rpx; 
  position: relative; 
} 
 
.content-header.container-header-info.container-header-info-text image { 
  width: 40rpx; 
  height: 40rpx; 
  position: absolute; 
  right: 0; 
} 
 
.container-teacher { 
  margin-top: 290rpx; 
  padding: 20rpx; 
  display: flex; 
  justify-content: space-between; 
  width: 100%; 
  color: #333333; 
  font-size: 36rpx; 
  font-weight: 600; 
}

 
 
.container-swiper { 
  width: 100%; 
  background: #ffffff; 
  padding: 20rpx; 
  box-sizing: border-box; 
} 
 
.container-swiper-item { 
  display: flex; 
  align-items: center; 
} 
 
.container-swiper-item-text { 
  padding: 20rpx; 
  font-size: 28rpx; 
  flex: 1; 
} 
 
.container-swiper-item-text-item { 
  padding: 6rpx; 
} 
 
.container-swiper-item-text-overflow { 
  display: -webkit-box; 
  -webkit-line-clamp: 3; 
  -webkit-box-orient: vertical; 
  overflow: hidden; 
  text-overflow: ellipsis; 
} 
 
.container-swiper-item-text-p { 
  padding: 6rpx; 
} 
 
.container-swiper-item-img { 
  width: 200rpx; 
  height: 200rpx; 
  border-radius: 50%; 
  box-shadow: 0rpx 0rpx 20rpx 10rpx #e6eceb; 
} 
 
.index-dialog-class-view { 
  text-align: center; 
  padding: 10rpx; 
} 
 
.container-info { 
  text-align: center; 
} 
 
.container-info-img { 
  width: 100rpx; 
  height: 100rpx; 
  border-radius: 50%; 
  box-shadow: 0 0 40rpx #e6eceb; 
} 
 
.container-info-text { 
  padding: 20rpx; 
} 
 
.container-list { 
  width: 100%; 
}

/* 课程详情区域样式 */
.course-detail-section {
  width: 100%;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  display: block;
  box-sizing: border-box;
}

.day-detail-header {
  font-size: 32rpx;
  color: #3f6f70;
  font-weight: bold;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e6eceb;
  text-align: center;
}

.day-detail-content {
  padding-top: 16rpx;
}

.course-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.course-time-section {
  width: 180rpx;
}

.course-time {
  font-size: 32rpx;
  color: #3f6f70;
  font-weight: bold;
  text-align: center;
}

.course-student {
  font-size: 24rpx;
  color: #3f6f70;
  margin-top: 8rpx;
  text-align: center;
}

.course-info {
  flex: 1;
}

.course-title {
  font-size: 28rpx;
  color: #333333;
}

.course-location {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.no-course {
  text-align: center;
  color: #9aabaa;
  font-size: 28rpx;
  padding: 40rpx 0;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }
