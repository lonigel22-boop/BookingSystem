<view class="content">
  <view class="content-course">
    <view wx:if="{{ myCourses && !myCourses.length }}" style="display: flex; flex-direction: column; align-items: center;padding: 80rpx;">
      <image 
      style="width: 240rpx; height: 200rpx;"
      src="../../images/nodata.png"
      />
      <view style="color: #fff; font-size: 32rpx; padding: 20rpx;">还没有课程</view>
    </view>
    <view wx:for="{{myCourses}}" wx:key="_id">
      <!-- <view class="content-course-item" wx:if="{{item.show}}"> -->
      <view class="content-course-item">
        <view class="content-course-item-title">{{item.title}}</view>
        <view>人数：{{item.numbers}} 人</view>
        <view>目标人群：{{item.target}}</view>
        <view>年龄：{{item.age}} 岁</view>
        <view>课时：{{item.periods}}期 {{item.pitch_number}}节*{{item.minute}} 分钟</view>
        <!-- <view>费用：
        {{item.expense_level_1 ? item.expense_level_1+'元' : ''}}
        {{item.expense_level_2 ? (' / ' + item.expense_level_2 + '元') : ''}}
        {{item.expense_level_3 ? (' / ' + item.expense_level_3 + '元') : ''}}</view> -->
        <van-button class="content-course-item-btn" color="#3f6f70" size="small" round bind:tap="appointmentCourse">查看</van-button>
      </view>
    </view>

    <!-- <view class="content-course-item">
      <view class="content-course-item-title">KSST 演唱初级课程（少儿版）</view>
      <view>人数：1 人</view>
      <view>目标人群：少儿零基础声乐</view>
      <view>年龄：2-12 岁</view>
      <view>课时：一期 12 节*45 分钟</view>
      <view>费用：3600 元/4800 元/6000 元/7200 元</view>
      <van-button class="content-course-item-btn" color="#3f6f70" size="small" round>预约</van-button>
    </view> -->
  </view>
</view>