page {
  text-align: center;
}

.icon {
  margin: 80rpx 0 50rpx 0;
}

.title {
  font-size: 42rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.info {
  font-size: 36rpx;
  width: 90%;
  margin: 0 auto;
}

.button {
  width: 300rpx;
  text-align: center;
  margin: 550rpx auto 0 auto;
  height: 80rpx;
  color: #4caf50;
  border-radius: 5px;
  line-height: 80rpx;
  background-color: rgba(0, 0, 0, 0.03);
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }


/* ===== v8 · 页面版式统一（ClassHourCatch 尺寸语言） =====
   按钮 80rpx/8rpx · 卡片 12rpx/20rpx · 列表 gap 20rpx · 标题左竖条 */

.icon-box-img {
  background: #ffffff;
  border: 1rpx solid #e6eceb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.button {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3f6f70;
  padding-left: 20rpx;
  border-left: 8rpx solid #3f6f70;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

input, textarea {
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  min-height: 80rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

button {
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

image { border-radius: 12rpx; }

.avatar, .container-info-img, .status-dot, .dot-green, .dot-red, .hero-deco, .hero-deco-a, .hero-deco-b { border-radius: 50%; }
