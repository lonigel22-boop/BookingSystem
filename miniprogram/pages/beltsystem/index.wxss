.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  box-sizing: border-box;
}

.status-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.dot-green {
  background: #6f9e7b;
  box-shadow: 0 0 10rpx #6f9e7b;
}

.dot-red {
  background: #e05a4f;
  box-shadow: 0 0 10rpx #e05a4f;
}

.status-text {
  flex: 1;
  font-size: 26rpx;
  color: #e6eceb;
}

.btn-mini {
  background: #3f6f70;
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.8;
}

.btn-gray {
  background: #666666;
}

.force-panel {
  background: linear-gradient(135deg, #ffffff, #f5f5f5);
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  margin-bottom: 20rpx;
  border: 1rpx solid #ffffff;
}

.force-number {
  font-size: 88rpx;
  font-weight: bold;
  color: #8aa88f;
}

.force-unit {
  font-size: 28rpx;
  color: #9aabaa;
  margin-left: 8rpx;
}

.force-label {
  display: block;
  font-size: 22rpx;
  color: #9aabaa;
  margin-top: 8rpx;
}

.ctrl-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.btn {
  flex: 1;
  font-size: 26rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  border: none;
  color: #333333;
}

.btn-primary {
  background: #3f6f70;
}

.btn-red {
  background: #e05a4f;
}

.btn-outline {
  background: transparent;
  border: 1rpx solid #8aa88f;
  color: #8aa88f;
}

.stat-row {
  display: flex;
  justify-content: space-around;
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.calib-row {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 10rpx;
  padding: 12rpx 8rpx;
  margin-bottom: 20rpx;
  font-size: 20rpx;
  color: #9aabaa;
}

.chart-wrapper {
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 12rpx;
  border: 1rpx solid #ffffff;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 8rpx 10rpx;
}

.chart-title {
  color: #666666;
  font-size: 26rpx;
}

.chart-sub {
  color: #9aabaa;
  font-size: 20rpx;
}

/* ★ 图表主体：左固定列 + 右滚动区，横排不换行 */
.chart-body {
  display: flex;
  align-items: stretch;
  width: 85vw;
  margin: 0 auto;
  background: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
}

/* ★ Y 轴固定列：不在 scroll-view 里，横滑永不移动 */
.y-axis {
  position: relative;
  flex: 0 0 34px;
  width: 34px;
  height: 680rpx;
  background: #ffffff;
  border-right: 1rpx solid #ffffff;
  box-sizing: border-box;
}

.y-hi,
.y-unit,
.y-lo {
  position: absolute;
  left: 3px;
  font-size: 20rpx;
  line-height: 1.2;
  color: #9aabaa;
  white-space: nowrap;
}

.y-hi {
  top: 24rpx;
}

.y-unit {
  top: 50%;
  transform: translateY(-50%);
  color: #9aabaa;
}

.y-lo {
  bottom: 56rpx;
}

/* ★ 滚动区占满剩余宽度，去掉原来的 85vw 固定宽 */
.chart-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  background: #ffffff;
}

.chart-inner {
  display: inline-block;
  vertical-align: top;
}

.chart {
  display: block;
  height: 680rpx;
  background: #ffffff;
}

.chart-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 8rpx 4rpx;
  font-size: 20rpx;
  color: #9aabaa;
}

.jump {
  color: #8aa88f;
}

.tip {
  text-align: center;
  padding: 24rpx;
}

.tip text {
  font-size: 22rpx;
  color: #666666;
}

/* ===== 全站统一主题收尾层（ClassHourCatch 风格） ===== */
page { background: #f5f5f5; color: #333333; }
.section-title, .page-title {
  color: #3f6f70;
  border-left: 8rpx solid #3f6f70;
  padding-left: 20rpx;
  font-weight: bold;
}
button[type="primary"], .primary-btn, .export-btn, .submit-btn,
.van-button--primary { background: #3f6f70; border-color: #3f6f70; color: #ffffff; }
button[disabled], .export-btn[disabled] { background: #cccccc; color: #ffffff; }
/* 深色页面上翻浅色后：提示条与主色按钮保持白字，避免白底白字 */
.toast { background: #3f6f70; color: #ffffff; border-color: #335b5c; }
.act.on, .dact.on, .fbtn.on, .mtab.on, .mebar-btn { color: #ffffff; }
